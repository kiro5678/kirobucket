{
    "version": "0.6.0-alpha",
    "description": "Windows file utility that opens a radial action wheel for converting, editing, and managing files.",
    "homepage": "https://github.com/i3sam/OrbitDrop",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/i3sam/OrbitDrop/releases/download/v0.6.0-alpha/OrbitDrop-Portable.zip",
            "hash": "5280b9f625e2c088793165924c3d8f4b6c1964e677ce666c4e9d5b7abfaf059c"
        }
    },
    "bin": "OrbitDrop.exe",
    "shortcuts": [
        [
            "OrbitDrop.exe",
            "OrbitDrop"
        ]
    ],
    "pre_uninstall": [
        "$registryKeys = @(",
        "    'HKCU:\\Software\\Classes\\AllFilesystemObjects\\shell\\OrbitDrop',",
        "    'HKCU:\\Software\\Classes\\CLSID\\{EF221BF9-D0CA-4698-95F2-5452942E7A5E}',",
        "    'HKCU:\\Software\\OrbitDrop'",
        ")",
        "foreach ($key in $registryKeys) {",
        "    Remove-Item -LiteralPath $key -Recurse -Force -ErrorAction SilentlyContinue",
        "}",
        "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'OrbitDrop' -ErrorAction SilentlyContinue",
        "Add-Type -Namespace ScoopOrbitDrop -Name ShellNotify -MemberDefinition '[System.Runtime.InteropServices.DllImport(\"shell32.dll\")] public static extern void SHChangeNotify(uint eventId, uint flags, System.IntPtr item1, System.IntPtr item2);'",
        "[ScoopOrbitDrop.ShellNotify]::SHChangeNotify(0x08000000, 0, [IntPtr]::Zero, [IntPtr]::Zero)"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/i3sam/OrbitDrop/releases?per_page=1",
        "jsonpath": "$[0].tag_name",
        "regex": "^v(?<version>.+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/i3sam/OrbitDrop/releases/download/v$version/OrbitDrop-Portable.zip"
            }
        }
    },
    "notes": [
        "Settings are stored under %APPDATA%\\OrbitDrop and logs under %LOCALAPPDATA%\\OrbitDrop; these locations remain after Scoop uninstall.",
        "OrbitDrop registers a File Explorer context-menu handler under HKCU. The manifest removes its registry entries and startup value during uninstall."
    ]
}
