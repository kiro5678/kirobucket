{
    "version": "26.10",
    "description": "Finds duplicate music files in formats including MP3, iTunes, Ogg/Vorbis, FLAC, and WMA.",
    "homepage": "https://efsoftware.com/d3/e.htm",
    "license": "Shareware",
    "architecture": {
        "64bit": {
            "url": "https://efsoftware.com/_p4/d3",
            "extract_dir": "ef_duplicate_mp3_finder_64",
            "shortcuts": [
                [
                    "EFD3F.EXE",
                    "EF Duplicate MP3 Finder"
                ]
            ]
        }
    },
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://efsoftware.com/dw/e.htm' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$needle = 'href=\"/d3/e.htm\"'",
            "$start = $html.IndexOf($needle, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($start -lt 0) { throw 'Could not locate EF Duplicate MP3 Finder in the official EFSoftware download page.' }",
            "$rowEnd = $html.IndexOf('</tr>', $start, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($rowEnd -lt 0) { throw 'Could not isolate the EF Duplicate MP3 Finder version row.' }",
            "$row = $html.Substring($start, $rowEnd - $start)",
            "$match = [regex]::Match($row, 'align=right>\\s*(?<version>\\d+\\.\\d+)')",
            "if (-not $match.Success) { throw 'Could not parse the EF Duplicate MP3 Finder version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://efsoftware.com/_p4/d3",
                "extract_dir": "ef_duplicate_mp3_finder_64"
            }
        }
    }
}
