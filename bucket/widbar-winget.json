{
    "version": "2026.08.29",
    "description": "Customizable widgets for the Windows 11 taskbar.",
    "homepage": "https://andelby.github.io/widbar/",
    "license": "Proprietary",
    "depends": "winget",
    "url": "https://raw.githubusercontent.com/kiro5678/kirobucket/master/scripts/widbar-winget.ps1",
    "hash": "1ead2be3bd024823dff5750363ce4f1c56066c529cafac2a7a356ca7b39803a2",
    "installer": {
        "script": [
            "$arch = @{ '64bit' = 'x64'; '32bit' = 'x86'; 'arm64' = 'arm64' }[$architecture]",
            "if (-not $arch) { error \"Unsupported architecture: $architecture\"; break }",
            "$package = & powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$dir\\$fname\" -ProductId '9PKLDNM83TP9' -OutputPath $dir -Architecture $arch",
            "if ($LASTEXITCODE -ne 0 -or -not $package) { error 'Failed to download the WidBar Microsoft Store package.'; break }",
            "$package = Get-Item -LiteralPath ($package | Select-Object -Last 1)",
            "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowershell 3>$null }",
            "Add-AppxPackage -Path $package.FullName -ErrorAction Stop"
        ]
    },
    "uninstaller": {
        "script": "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowershell 3>$null }; Get-AppxPackage '30113AndreaDelBello.WidBar-WidgetTaskbarsystem*' | Remove-AppxPackage -ErrorAction SilentlyContinue"
    },
    "checkver": {
        "script": [
            "$output = & winget.exe show --id 9PKLDNM83TP9 --source msstore --exact --accept-source-agreements --disable-interactivity 2>&1",
            "$match = $output | Select-String -Pattern '^Version:\\s*([0-9]+(?:\\.[0-9]+)+)' | Select-Object -First 1",
            "if (-not $match) { throw 'WinGet did not return a WidBar version.' }",
            "$match.Matches[0].Groups[1].Value"
        ]
    }
}
