{
    "version": "26.10",
    "description": "Batch-renames files and directories using reusable rules, filters, and a real-time preview.",
    "homepage": "https://efsoftware.com/mr/e.htm",
    "license": "Shareware",
    "architecture": {
        "64bit": {
            "url": "https://efsoftware.com/_p4/mr",
            "extract_dir": "ef_multi_file_renamer_64",
            "shortcuts": [
                [
                    "EFMR.EXE",
                    "EF Multi File Renamer"
                ]
            ]
        }
    },
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://efsoftware.com/dw/e.htm' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$needle = 'href=\"/mr/e.htm\"'",
            "$start = $html.IndexOf($needle, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($start -lt 0) { throw 'Could not locate EF Multi File Renamer in the official EFSoftware download page.' }",
            "$rowEnd = $html.IndexOf('</tr>', $start, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($rowEnd -lt 0) { throw 'Could not isolate the EF Multi File Renamer version row.' }",
            "$row = $html.Substring($start, $rowEnd - $start)",
            "$match = [regex]::Match($row, 'align=right>\\s*(?<version>\\d+\\.\\d+)')",
            "if (-not $match.Success) { throw 'Could not parse the EF Multi File Renamer version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://efsoftware.com/_p4/mr",
                "extract_dir": "ef_multi_file_renamer_64"
            }
        }
    }
}
