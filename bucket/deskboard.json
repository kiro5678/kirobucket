    "hash": "0812aa7a5667c4820a0c30d72afb72939e5c74c4f251580c41c4cd71c9287ebc",
    "bin": "deskboard.exe",
    "shortcuts": [
        [
            "deskboard.exe",
            "Deskboard"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://deskboard.geeke.app/download' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+v?(?<version>\\d+(?:\\.\\d+)+)')",
            "if (-not $match.Success) { throw 'Unable to detect the Deskboard release version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://deskboard.geeke.app/downloads/windows/Deskboard_$version_x64-setup.exe#/dl.7z"
    }
}
