{
    "version": "2026.08.29",
    "description": "Customizable widgets for the Windows 11 taskbar.",
    "homepage": "https://andelby.github.io/widbar/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://raw.githubusercontent.com/kiro5678/kirobucket/master/scripts/widbar-store.ps1",
            "hash": "52ac5cad34d7f3f4dba7c14d03cd900251e0f2c6430acf3dcb1299a39e6e0e05"
        },
        "arm64": {
            "url": "https://raw.githubusercontent.com/kiro5678/kirobucket/master/scripts/widbar-store.ps1",
            "hash": "52ac5cad34d7f3f4dba7c14d03cd900251e0f2c6430acf3dcb1299a39e6e0e05"
        }
    },
    "installer": {
        "script": [
            "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
            "$package = & powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$dir\$fname\" -ProductId '9PKLDNM83TP9' -OutputPath $dir -Architecture $arch",
            "if ($LASTEXITCODE -ne 0 -or -not $package) { error 'Failed to download the WidBar Microsoft Store package.'; break }",
            "$package = $package | Select-Object -Last 1",
            "Expand-7zipArchive -Path $package -DestinationPath \"$dir\_package\" -Removal",
            "$files = Get-ChildItem -LiteralPath \"$dir\_package\" -Force",
            "foreach ($file in $files) { Move-Item -LiteralPath $file.FullName -Destination $dir -Force }",
            "Remove-Item -LiteralPath \"$dir\_package\" -Force -Recurse -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath \"$dir\$fname\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "Get-AppxPackage '30113AndreaDelBello.WidBar-WidgetTaskbarsystem*' | Remove-AppxPackage -ErrorAction SilentlyContinue"
        ]
    },
    "checkver": {
        "url": "https://appagg.com/windows/utilitiesandtools/widbar-widget-taskbar-system-43311425.html?hl=en",
        "regex": "Last Updated:\s*([0-9]{4}-[0-9]{2}-[0-9]{2})",
        "replace": "$1"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://raw.githubusercontent.com/kiro5678/kirobucket/master/scripts/widbar-store.ps1",
                "hash": "52ac5cad34d7f3f4dba7c14d03cd900251e0f2c6430acf3dcb1299a39e6e0e05"
            },
            "arm64": {
                "url": "https://raw.githubusercontent.com/kiro5678/kirobucket/master/scripts/widbar-store.ps1",
                "hash": "52ac5cad34d7f3f4dba7c14d03cd900251e0f2c6430acf3dba7c14d03cd900251e0f2c6430acf3dcb1299a39e6e0e05"
            }
        }
    }
}