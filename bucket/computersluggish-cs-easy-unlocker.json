{
    "version": "1.1.7.0",
    "description": "Identifies processes locking files or folders and helps release handles that prevent access.",
    "homepage": "https://computersluggish.com/cs-easy-unlocker/",
    "license": "Freemium",
    "url": "https://downloads.computersluggish.com/CSEasyUnlocker.exe",
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://computersluggish.com/downloads/cs-easy-unlocker/' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$match = [regex]::Match($text, '(?i)Current\\s+version\\s*:\\s*(?<version>\\d+(?:\\.\\d+)+)')",
            "if (-not $match.Success) { throw 'Could not parse the current CS Easy Unlocker version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://downloads.computersluggish.com/CSEasyUnlocker.exe"
    },
    "bin": "CSEasyUnlocker.exe",
    "shortcuts": [
        [
            "CSEasyUnlocker.exe",
            "ComputerSluggish CS Easy Unlocker"
        ]
    ],
    "notes": [
        "Upstream does not publish a SHA-256 digest; the checksum is not pinned in this manifest.",
        "The publisher labels this download as the portable version with no installation required."
    ]
}
