{
    "version": "26.10",
    "description": "Inspects running processes and loaded modules, closes or terminates processes, and displays system details.",
    "homepage": "https://efsoftware.com/pm/e.htm",
    "license": "Shareware",
    "architecture": {
        "64bit": {
            "url": "https://efsoftware.com/_p4/pm",
            "extract_dir": "ef_process_manager_64",
            "shortcuts": [
                [
                    "EFPrcMan.exe",
                    "EF Process Manager"
                ]
            ]
        }
    },
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://efsoftware.com/dw/e.htm' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$needle = 'href=\"/pm/e.htm\"'",
            "$start = $html.IndexOf($needle, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($start -lt 0) { throw 'Could not locate EF Process Manager in the official EFSoftware download page.' }",
            "$rowEnd = $html.IndexOf('</tr>', $start, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($rowEnd -lt 0) { throw 'Could not isolate the EF Process Manager version row.' }",
            "$row = $html.Substring($start, $rowEnd - $start)",
            "$match = [regex]::Match($row, 'align=right>\\s*(?<version>\\d+\\.\\d+)')",
            "if (-not $match.Success) { throw 'Could not parse the EF Process Manager version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://efsoftware.com/_p4/pm",
                "extract_dir": "ef_process_manager_64"
            }
        }
    }
}
