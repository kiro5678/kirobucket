{
    "version": "0.10.2",
    "description": "Offline speech-to-text desktop app with local Whisper and Parakeet transcription.",
    "homepage": "https://handy.computer/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/cjpais/Handy/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/cjpais/Handy/releases/download/v0.10.2/Handy_0.10.2_x64-setup.exe",
            "hash": "2ba683434110fbda3ea68e244fe2ae2d49fa639b8a2d46790bec67e57c6e280c"
        },
        "arm64": {
            "url": "https://github.com/cjpais/Handy/releases/download/v0.10.2/Handy_0.10.2_arm64-setup.exe",
            "hash": "2bdb2b91ebabee7856fee1e49716bdf85c6e075991af39277efe24d67af8196d"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/PORTABLE",
            "/D=$dir"
        ]
    },
    "bin": "handy.exe",
    "shortcuts": [
        [
            "handy.exe",
            "Handy"
        ]
    ],
    "persist": "Data",
    "checkver": {
        "github": "https://github.com/cjpais/Handy",
        "regex": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cjpais/Handy/releases/download/v$version/Handy_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/cjpais/Handy/releases/download/v$version/Handy_$version_arm64-setup.exe"
            }
        }
    }
}
