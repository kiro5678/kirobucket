{
    "version": "0.10.1",
    "description": "Offline speech-to-text desktop app with local Whisper and Parakeet transcription.",
    "homepage": "https://handy.computer/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/cjpais/Handy/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/cjpais/Handy/releases/download/v0.10.1/Handy_0.10.1_x64-setup.exe",
            "hash": "3d0c05cfe2717370e64ca71e6cb36dd575d8b0f28424f48e00efe18565a04edf"
        },
        "arm64": {
            "url": "https://github.com/cjpais/Handy/releases/download/v0.10.1/Handy_0.10.1_arm64-setup.exe",
            "hash": "b001d3c58d61e09529bc9e18a1df5eb64bd42681d69b034db3a354edecc33650"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/PORTABLE",
            "/D=$dir"
        ]
    },
    "bin": "handy.exe",
    "shortcuts": [
        [
            "handy.exe",
            "Handy"
        ]
    ],
    "persist": "Data",
    "checkver": {
        "github": "https://github.com/cjpais/Handy",
        "regex": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cjpais/Handy/releases/download/v$version/Handy_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/cjpais/Handy/releases/download/v$version/Handy_$version_arm64-setup.exe"
            }
        }
    }
}
