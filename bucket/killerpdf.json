{
    "version": "1.9.4",
    "description": "Free and open-source Windows PDF editor installed with the official KillerPDF setup package, including OCR, annotation, text editing, redaction, signing, forms, comparison and conversion.",
    "homepage": "https://killerpdf.net/",
    "license": "GPL-3.0-only",
    "url": "https://github.com/SteveTheKiller/KillerPDF/releases/download/v1.9.4/KillerPDF.exe",
    "hash": "6941cb34005615a42d6a654334e28477ff525c7baaadec7dbae54d61890eeb56",
    "pre_install": [
        "$ErrorActionPreference = 'Stop'",
        "$runtimeRoot = Join-Path $env:ProgramFiles 'dotnet'",
        "if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { $runtimeRoot = Join-Path $runtimeRoot 'x64' }",
        "$desktopRuntimePath = Join-Path $runtimeRoot 'shared\\Microsoft.WindowsDesktop.App'",
        "$desktopRuntime = Get-ChildItem -LiteralPath $desktopRuntimePath -Directory -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^10\\.' } | Select-Object -First 1",
        "if ($null -eq $desktopRuntime) { throw 'KillerPDF requires the .NET 10 Desktop Runtime (x64). Install it with: winget install --id Microsoft.DotNet.DesktopRuntime.10 --exact' }",
        "if (-not (Test-Path -LiteralPath (Join-Path $dir 'KillerPDF.exe') -PathType Leaf)) { throw 'The official KillerPDF setup executable is missing.' }"
    ],
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$setupSource = Join-Path $dir 'KillerPDF.exe'",
            "$setupPath = Join-Path $env:TEMP ('KillerPDF-Setup-' + [guid]::NewGuid().ToString('N') + '.exe')",
            "Move-Item -LiteralPath $setupSource -Destination $setupPath -Force",
            "$installPath = [System.IO.Path]::GetFullPath($dir)",
            "$installDirArg = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($installPath))",
            "Write-Host \"KillerPDF Scoop target: $installPath\"",
            "$previousSkipRegistration = [Environment]::GetEnvironmentVariable('KILLERPDF_SKIP_REGISTRATION', 'Process')",
            "$env:KILLERPDF_SKIP_REGISTRATION = '1'",
            "try {",
            "& $setupPath '/install-user' \"/install-dir64:$installDirArg\"",
            "$installExitCode = $LASTEXITCODE",
            "Write-Host \"KillerPDF setup exit code: $installExitCode\"",
            "} finally {",
            "if ($null -eq $previousSkipRegistration) { Remove-Item Env:KILLERPDF_SKIP_REGISTRATION -ErrorAction SilentlyContinue } else { $env:KILLERPDF_SKIP_REGISTRATION = $previousSkipRegistration }",
            "if (Test-Path -LiteralPath $setupPath) { Remove-Item -LiteralPath $setupPath -Force -ErrorAction SilentlyContinue }",
            "}",
            "if ($installExitCode -ne 0) { throw \"KillerPDF installer failed with exit code $installExitCode.\" }",
            "Write-Host 'KillerPDF target directory contents after setup:'",
            "Get-ChildItem -LiteralPath $dir -Force | ForEach-Object { Write-Host (($_.Mode) + ' ' + $_.Name) }",
            "$appExe = Join-Path $dir 'KillerPDF.App.exe'",
            "$payloadManifest = Join-Path $dir 'payload.manifest'",
            "if (-not (Test-Path -LiteralPath $appExe -PathType Leaf) -or -not (Test-Path -LiteralPath $payloadManifest -PathType Leaf)) {",
            "$userInstall = Join-Path $env:LOCALAPPDATA 'Programs\\KillerPDF'",
            "$machineInstall = Join-Path $env:ProgramFiles 'KillerPDF'",
            "Write-Host \"Default user install exists: $(Test-Path -LiteralPath $userInstall)\"",
            "Write-Host \"Default machine install exists: $(Test-Path -LiteralPath $machineInstall)\"",
            "throw 'The KillerPDF installer did not produce a complete application payload in the Scoop target directory.'",
            "}",
            "$wrapper = '@\"%~dp0KillerPDF.App.exe\" %*' + [Environment]::NewLine + '@exit /b %ERRORLEVEL%' + [Environment]::NewLine",
            "[System.IO.File]::WriteAllText((Join-Path $dir 'KillerPDF.cmd'), $wrapper, [System.Text.Encoding]::ASCII)"
        ]
    },
    "bin": [
        [
            "KillerPDF.cmd",
            "killerpdf"
        ]
    ],
    "shortcuts": [
        [
            "KillerPDF.cmd",
            "KillerPDF"
        ]
    ],
    "checkver": {
        "github": "https://github.com/SteveTheKiller/KillerPDF",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/SteveTheKiller/KillerPDF/releases/download/v$version/KillerPDF.exe",
        "hash": {
            "url": "https://github.com/SteveTheKiller/KillerPDF/releases/download/v$version/SHA256SUMS.txt",
            "find": "(?im)^KillerPDF\\.exe\\s+($sha256)\\s*$"
        }
    },
    "notes": [
        "This manifest uses the official non-portable installer but directs its files into the Scoop-managed version directory. Scoop controls updates and removal; installer registration is skipped to avoid stale shortcuts and registry entries when Scoop changes versions.",
        "The .NET 10 Desktop Runtime (x64) must already be installed system-wide. Install it with 'winget install --id Microsoft.DotNet.DesktopRuntime.10 --exact' if it is missing."
    ]
}
