{
    "version": "1.4.0",
    "description": "Read-only Windows diagnostics for Event Log, system health, inventory and reports, with an optional local AI assistant.",
    "homepage": "https://github.com/Regncreative/Pulse",
    "license": "MIT",
    "url": "https://github.com/Regncreative/Pulse/releases/download/v1.4.0/Pulse-1.4.0-windows-x64.zip",
    "hash": "c12269475f4cd307b82627953dbf6eaff665148bb671139e584a1e97dd32e9bf",
    "bin": "Pulse.exe",
    "shortcuts": [
        [
            "Pulse.exe",
            "Pulse"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Regncreative/Pulse"
    },
    "autoupdate": {
        "url": "https://github.com/Regncreative/Pulse/releases/download/v$version/Pulse-$version-windows-x64.zip"
    },
    "pre_install": [
        "$service = Get-CimInstance -ClassName Win32_Service -Filter \"Name='PulseService'\" -ErrorAction SilentlyContinue",
        "if ($service) {",
        "    $pathMatch = [regex]::Match([string]$service.PathName, '^\\s*\"(?<path>[^\"]+\\.exe)\"', [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)",
        "    if (-not $pathMatch.Success) { $pathMatch = [regex]::Match([string]$service.PathName, '^\\s*(?<path>.+?\\.exe)(?:\\s|$)', [System.Text.RegularExpressions.RegexOptions]::IgnoreCase) }",
        "    if (-not $pathMatch.Success) { throw 'PulseService is registered, but its executable path could not be identified. Refusing to overwrite an unknown service installation.' }",
        "    $registeredExe = [IO.Path]::GetFullPath($pathMatch.Groups['path'].Value)",
        "    $appRoot = [IO.Path]::GetFullPath((Split-Path -Parent $dir)).TrimEnd([char]92) + [char]92",
        "    if (-not $registeredExe.StartsWith($appRoot, [StringComparison]::OrdinalIgnoreCase)) { throw ('PulseService is already registered outside this Scoop-managed installation: {0}. Uninstall that Pulse copy before using the Scoop package.' -f $registeredExe) }",
        "}"
    ],
    "post_install": [
        "$serviceExe = Join-Path $dir 'service\\PulseService.exe'",
        "if (-not (Test-Path -LiteralPath $serviceExe -PathType Leaf)) { throw 'PulseService.exe is missing from the Pulse payload.' }",
        "$redist = Join-Path $dir 'redist\\VC_redist.x64.exe'",
        "$service = Get-CimInstance -ClassName Win32_Service -Filter \"Name='PulseService'\" -ErrorAction SilentlyContinue",
        "$hasService = $null -ne $service",
        "$serviceLiteral = \"'\" + $serviceExe.Replace(\"'\", \"''\") + \"'\"",
        "$redistLiteral = \"'\" + $redist.Replace(\"'\", \"''\") + \"'\"",
        "$hasServiceLiteral = if ($hasService) { '$true' } else { '$false' }",
        "$command = @(",
        "    '$ErrorActionPreference = ''Stop''',",
        "    'if (Test-Path -LiteralPath __REDIST_PATH__ -PathType Leaf) {',",
        "    '    & __REDIST_PATH__ /install /quiet /norestart',",
        "    '    $runtimeCode = $LASTEXITCODE',",
        "    '    if ($runtimeCode -notin @(0, 1638, 3010)) { Write-Warning (''Visual C++ Redistributable returned exit code {0}.'' -f $runtimeCode) }',",
        "    '}',",
        "    'if (__HAS_SERVICE__) {',",
        "    '    & __SERVICE_PATH__ --stop',",
        "    '    $stopCode = $LASTEXITCODE',",
        "    '    if ($stopCode -ne 0) { exit $stopCode }',",
        "    '}',",
        "    '& __SERVICE_PATH__ --install-start',",
        "    'exit $LASTEXITCODE'",
        ") -join [Environment]::NewLine",
        "$command = $command.Replace('__SERVICE_PATH__', $serviceLiteral).Replace('__REDIST_PATH__', $redistLiteral).Replace('__HAS_SERVICE__', $hasServiceLiteral)",
        "$encodedCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))",
        "$powerShell = (Get-Command powershell.exe -ErrorAction Stop).Source",
        "$process = Start-Process -FilePath $powerShell -ArgumentList @('-NoProfile', '-EncodedCommand', $encodedCommand) -Verb RunAs -Wait -PassThru",
        "if ($process.ExitCode -ne 0) { throw ('PulseService installation or startup failed with exit code {0}.' -f $process.ExitCode) }",
        "Remove-Item -LiteralPath (Join-Path $dir 'redist') -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "pre_uninstall": [
        "$service = Get-CimInstance -ClassName Win32_Service -Filter \"Name='PulseService'\" -ErrorAction SilentlyContinue",
        "if ($service) {",
        "    $pathMatch = [regex]::Match([string]$service.PathName, '^\\s*\"(?<path>[^\"]+\\.exe)\"', [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)",
        "    if (-not $pathMatch.Success) { $pathMatch = [regex]::Match([string]$service.PathName, '^\\s*(?<path>.+?\\.exe)(?:\\s|$)', [System.Text.RegularExpressions.RegexOptions]::IgnoreCase) }",
        "    if (-not $pathMatch.Success) { throw 'PulseService is registered, but its executable path could not be identified. Refusing to remove an unknown service installation.' }",
        "    $registeredExe = [IO.Path]::GetFullPath($pathMatch.Groups['path'].Value)",
        "    $appRoot = [IO.Path]::GetFullPath((Split-Path -Parent $dir)).TrimEnd([char]92) + [char]92",
        "    if ($registeredExe.StartsWith($appRoot, [StringComparison]::OrdinalIgnoreCase)) {",
        "        $serviceExe = Join-Path $dir 'service\\PulseService.exe'",
        "        if (-not (Test-Path -LiteralPath $serviceExe -PathType Leaf)) { $serviceExe = $registeredExe }",
        "        if (-not (Test-Path -LiteralPath $serviceExe -PathType Leaf)) { throw 'Could not find PulseService.exe to remove the Scoop-managed service.' }",
        "        $process = Start-Process -FilePath $serviceExe -ArgumentList '--uninstall' -WorkingDirectory (Split-Path -Parent $serviceExe) -Verb RunAs -Wait -PassThru",
        "        if ($process.ExitCode -ne 0) { throw ('PulseService removal failed with exit code {0}.' -f $process.ExitCode) }",
        "    } else {",
        "        Write-Warning 'PulseService is registered outside this Scoop installation; leaving that service untouched.'",
        "    }",
        "}"
    ],
    "notes": "The release ZIP is a payload, not a true portable edition. PulseService is required; Scoop registers and starts it with one administrator/UAC prompt and removes it on Scoop uninstall. The Visual C++ runtime is installed if needed and is not removed on uninstall. User settings and logs remain under %LOCALAPPDATA%\\Pulse."
}
