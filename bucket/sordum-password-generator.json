{
    "version": "2020.10.23",
    "description": "Portable random password generator. The upstream page does not publish a semantic version; this manifest uses its published release date.",
    "homepage": "https://www.sordum.org/10946/sordum-random-password-generator/",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.sordum.org/eula/"
    },
    "url": "https://www.sordum.org/files/random-password-generator/RandomPW.zip",
    "autoupdate": {
        "url": "https://www.sordum.org/files/random-password-generator/RandomPW.zip"
    },
    "bin": [
        [
            "RandomPW.exe",
            "SordumRandomPasswordGenerator"
        ]
    ],
    "shortcuts": [
        [
            "RandomPW.exe",
            "Sordum - Random Password Generator"
        ]
    ],
    "persist": "RandomPW.ini",
    "checkver": {
        "url": "https://www.sordum.org/10946/sordum-random-password-generator/",
        "regex": "Release date\\s*:\\s*Friday\\s*,\\s*(\\d{1,2})\\s+October\\s+(\\d{4})",
        "replace": "$2.10.$1"
    }
}
