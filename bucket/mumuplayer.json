{
    "version": "1.8.16.6114",
    "description": "Android emulator for Windows (NX main engine)",
    "homepage": "https://www.mumuplayer.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://a11.gdl.easebar.com/MuMu-setup-nxmain-V1.8.16.6114-overseas-1119205802.exe",
            "hash": "16583e0f6c8d54e99ebc2926340bacf7b7dbca575919bf5adeba3e6d2d262c45"
        }
    },
    "pre_install": [
        "if (!(is_admin)) { throw \"$app requires admin rights to $cmd\" }",
        "",
        "$sourceInstaller = Join-Path $dir $fname",
        "$downloadUrl = \"https://a11.gdl.easebar.com/$fname\"",
        "$cachedInstaller = cache_path $app $version $downloadUrl",
        "$transactionId = [guid]::NewGuid().ToString()",
        "$stagingDir = $null",
        "$scoopAppRoot = Split-Path -Path $dir -Parent",
        "$installRoot = [IO.Path]::GetFullPath($dir).TrimEnd('\\')",
        "$serviceName = 'MuMuPlayerRemoteService'",
        "$registryPaths = if ($env:MUMU_SCOOP_TEST_MODE -eq '1') {",
        "    @($env:MUMU_SCOOP_TEST_REGISTRY_PATH)",
        "} else {",
        "    @(",
        "        'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\MuMuPlayerGlobal',",
        "        'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\MuMuPlayerGlobal'",
        "    )",
        "}",
        "$script:registryChanges = New-Object System.Collections.ArrayList",
        "$serviceSnapshot = $null",
        "",
        "function Test-MuMuPathReference([string]$Text, [string[]]$Roots) {",
        "    if ([string]::IsNullOrWhiteSpace($Text)) { return $false }",
        "    foreach ($root in $Roots) {",
        "        if ([string]::IsNullOrWhiteSpace($root)) { continue }",
        "        $normalized = [IO.Path]::GetFullPath($root).TrimEnd('\\', '/')",
        "        $pattern = [regex]::Escape($normalized) + '(?=\\\\|/|[\"\\s,]|$)'",
        "        if ([regex]::IsMatch($Text, $pattern, [Text.RegularExpressions.RegexOptions]::IgnoreCase)) {",
        "            return $true",
        "        }",
        "    }",
        "    return $false",
        "}",
        "",
        "function Get-MuMuPreviousScoopVersionRoot {",
        "    $targetVersion = [version]$version",
        "    $candidates = foreach ($entry in @(Get-ChildItem -LiteralPath $scoopAppRoot -Directory -Force -ErrorAction SilentlyContinue)) {",
        "        $candidateVersion = $null",
        "",
        "        if ($entry.Name -match '^(?<version>\\d+(?:\\.\\d+)+)$') {",
        "            $candidateVersionText = $Matches.version",
        "            if ([IO.Path]::GetFullPath($entry.FullName).TrimEnd('\\') -ieq $installRoot) { continue }",
        "            $candidateVersion = [version]$candidateVersionText",
        "            if ($candidateVersion -ge $targetVersion) { continue }",
        "        } elseif ($entry.Name -match '^_(?<version>\\d+(?:\\.\\d+)+)\\.old(?:\\(\\d+\\))?$') {",
        "            $candidateVersionText = $Matches.version",
        "            $candidateVersion = [version]$candidateVersionText",
        "            if ($candidateVersion -ne $targetVersion) { continue }",
        "        } else {",
        "            continue",
        "        }",
        "",
        "        $previousExecutable = Join-Path $entry.FullName 'nx_main\\MuMuNxMain.exe'",
        "        if (-not (Test-Path -LiteralPath $previousExecutable -PathType Leaf)) { continue }",
        "",
        "        [pscustomobject]@{",
        "            Root = [IO.Path]::GetFullPath($entry.FullName)",
        "            Version = $candidateVersion",
        "            Modified = $entry.LastWriteTimeUtc",
        "        }",
        "    }",
        "",
        "    $previous = $candidates |",
        "        Sort-Object @{ Expression = 'Version'; Descending = $true }, @{ Expression = 'Modified'; Descending = $true } |",
        "        Select-Object -First 1",
        "",
        "    if ($previous) { return $previous.Root }",
        "    return $null",
        "}",
        "",
        "function Open-MuMuRegistryKey([string]$Path, [bool]$Writable) {",
        "    if ($Path -match '^HKLM:\\\\(.+)$') {",
        "        return [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($Matches[1], $Writable)",
        "    }",
        "    if ($Path -match '^HKCU:\\\\(.+)$') {",
        "        return [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey($Matches[1], $Writable)",
        "    }",
        "    throw \"Unsupported MuMuPlayer Registry path: $Path\"",
        "}",
        "",
        "function Replace-MuMuRootInText([string]$Text, [string]$OldRoot, [string]$NewRoot) {",
        "    if ([string]::IsNullOrWhiteSpace($Text) -or [string]::IsNullOrWhiteSpace($OldRoot)) { return $Text }",
        "    $old = [IO.Path]::GetFullPath($OldRoot).TrimEnd('\\', '/')",
        "    $replacement = [IO.Path]::GetFullPath($NewRoot).TrimEnd('\\', '/')",
        "    $pattern = [regex]::Escape($old) + '(?=\\\\|/|[\"\\s,]|$)'",
        "    return [regex]::Replace(",
        "        $Text,",
        "        $pattern,",
        "        [Text.RegularExpressions.MatchEvaluator]{ param($match) $replacement },",
        "        [Text.RegularExpressions.RegexOptions]::IgnoreCase",
        "    )",
        "}",
        "",
        "function Update-MuMuUninstallRegistration([string]$OldRoot, [string]$NewRoot) {",
        "    foreach ($path in $registryPaths) {",
        "        if ([string]::IsNullOrWhiteSpace($path)) { continue }",
        "        $key = Open-MuMuRegistryKey $path $true",
        "        if ($null -eq $key) { continue }",
        "",
        "        try {",
        "            $hasOldReference = $false",
        "            foreach ($name in $key.GetValueNames()) {",
        "                $value = $key.GetValue(",
        "                    $name,",
        "                    $null,",
        "                    [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames",
        "                )",
        "                if ($value -is [string] -and (Test-MuMuPathReference $value @($OldRoot))) {",
        "                    $hasOldReference = $true",
        "                    break",
        "                }",
        "            }",
        "",
        "            if (-not $hasOldReference) { continue }",
        "",
        "            foreach ($name in $key.GetValueNames()) {",
        "                $value = $key.GetValue(",
        "                    $name,",
        "                    $null,",
        "                    [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames",
        "                )",
        "                if ($value -isnot [string]) { continue }",
        "",
        "                $updated = Replace-MuMuRootInText $value $OldRoot $NewRoot",
        "                if ($name -ieq 'InstallLocation' -and -not [string]::IsNullOrWhiteSpace($value)) {",
        "                    $updated = $NewRoot",
        "                }",
        "",
        "                if ($updated -ne $value) {",
        "                    $script:registryChanges.Add([pscustomobject]@{",
        "                        Path = $path",
        "                        Name = $name",
        "                        Value = $value",
        "                        Kind = $key.GetValueKind($name)",
        "                    }) | Out-Null",
        "                    $key.SetValue($name, $updated, $key.GetValueKind($name))",
        "                }",
        "            }",
        "            $key.Flush()",
        "        } finally {",
        "            $key.Close()",
        "        }",
        "    }",
        "}",
        "",
        "function Restore-MuMuRegistryChanges {",
        "    for ($index = $script:registryChanges.Count - 1; $index -ge 0; $index--) {",
        "        $entry = $script:registryChanges[$index]",
        "        $key = Open-MuMuRegistryKey $entry.Path $true",
        "        if ($null -eq $key) {",
        "            throw \"Could not reopen Registry key during rollback: $($entry.Path)\"",
        "        }",
        "        try {",
        "            $key.SetValue($entry.Name, $entry.Value, $entry.Kind)",
        "            $key.Flush()",
        "        } finally {",
        "            $key.Close()",
        "        }",
        "    }",
        "}",
        "",
        "function Set-MuMuServiceImagePath([string]$PathName) {",
        "    if ($env:MUMU_SCOOP_TEST_MODE -eq '1') {",
        "        $script:MockMuMuServicePath = $PathName",
        "        return",
        "    }",
        "",
        "    $sc = Join-Path $env:SystemRoot 'System32\\sc.exe'",
        "    & $sc config $serviceName binPath= $PathName | Out-Null",
        "    if ($LASTEXITCODE -ne 0) {",
        "        throw \"Could not update the $serviceName service image path. sc.exe exit code: $LASTEXITCODE\"",
        "    }",
        "}",
        "",
        "function Update-MuMuServicePath([string]$OldRoot, [string]$NewRoot) {",
        "    if ($env:MUMU_SCOOP_TEST_MODE -eq '1') {",
        "        $current = [string]$script:MockMuMuServicePath",
        "    } else {",
        "        $service = Get-CimInstance -ClassName Win32_Service -Filter \"Name='$serviceName'\" -ErrorAction SilentlyContinue",
        "        if (-not $service) { return $null }",
        "        $current = [string]$service.PathName",
        "    }",
        "",
        "    if ([string]::IsNullOrWhiteSpace($current)) { return $null }",
        "    $updated = Replace-MuMuRootInText $current $OldRoot $NewRoot",
        "    if ($updated -eq $current) { return $null }",
        "",
        "    Set-MuMuServiceImagePath $updated",
        "    return $current",
        "}",
        "",
        "$previousInstallRoot = Get-MuMuPreviousScoopVersionRoot",
        "",
        "try {",
        "    if (Test-Path -LiteralPath $cachedInstaller -PathType Leaf) {",
        "        $installerPath = $cachedInstaller",
        "        Remove-Item -LiteralPath $sourceInstaller -Force",
        "    } else {",
        "        $scoopRoot = Split-Path (Split-Path (Split-Path $dir -Parent) -Parent) -Parent",
        "        $stagingDir = Join-Path $scoopRoot \"cache\\mumuplayer-installer-$transactionId\"",
        "        New-Item -ItemType Directory -Path $stagingDir -Force | Out-Null",
        "        $installerPath = Join-Path $stagingDir $fname",
        "        Copy-Item -LiteralPath $sourceInstaller -Destination $installerPath -Force",
        "        Remove-Item -LiteralPath $sourceInstaller -Force",
        "    }",
        "",
        "    $remainingFiles = @(Get-ChildItem -LiteralPath $dir -Force)",
        "    if ($remainingFiles.Count -gt 0) {",
        "        throw \"MuMuPlayer target directory must be empty before setup. Unexpected item: $($remainingFiles[0].FullName)\"",
        "    }",
        "",
        "    $versionParts = $version -split '\\.'",
        "    if ($versionParts.Count -lt 3) {",
        "        throw \"Cannot derive MuMuPlayer product version from NXMAIN version $version.\"",
        "    }",
        "    $productVersion = \"6.$($versionParts[1]).$($versionParts[2]).0\"",
        "    $commonArguments = @(",
        "        \"/from_orchestrator=1\",",
        "        \"/txn_id=$transactionId\",",
        "        \"/silent=1\",",
        "        \"/product_version=$productVersion\",",
        "        \"/auto_start=false\",",
        "        \"/fchannel=gw-win-download\",",
        "        \"/auto_run=false\",",
        "        \"/D=$installRoot\"",
        "    )",
        "",
        "    $prepareArguments = @(\"/from_orchestrator=1\", \"/action=install_prepare\") + $commonArguments[1..($commonArguments.Count - 1)]",
        "    $prepare = Start-Process -FilePath $installerPath -ArgumentList $prepareArguments -Wait -PassThru",
        "    if ($prepare.ExitCode -ne 0) {",
        "        throw \"MuMuPlayer NX-main install_prepare failed with exit code $($prepare.ExitCode).\"",
        "    }",
        "",
        "    Start-Sleep -Seconds 12",
        "",
        "    $commitArguments = @(\"/from_orchestrator=1\", \"/action=commit\") + $commonArguments[1..($commonArguments.Count - 1)]",
        "    $commit = Start-Process -FilePath $installerPath -ArgumentList $commitArguments -Wait -PassThru",
        "    if ($commit.ExitCode -ne 0) {",
        "        throw \"MuMuPlayer NX-main commit failed with exit code $($commit.ExitCode).\"",
        "    }",
        "",
        "    $mainExe = Join-Path $installRoot 'nx_main\\MuMuNxMain.exe'",
        "    if (-not (Test-Path -LiteralPath $mainExe -PathType Leaf)) {",
        "        throw \"MuMuPlayer setup returned successfully but did not create the expected executable: $mainExe\"",
        "    }",
        "",
        "    if ($previousInstallRoot) {",
        "        Write-Host \"Updating MuMuPlayer Registry and service paths: '$previousInstallRoot' -> '$installRoot'\"",
        "        $serviceSnapshot = Update-MuMuServicePath $previousInstallRoot $installRoot",
        "        Update-MuMuUninstallRegistration $previousInstallRoot $installRoot",
        "    } else {",
        "        Write-Host 'No previous Scoop version directory was found. Existing external MuMuPlayer registrations were left unchanged.'",
        "    }",
        "} catch {",
        "    $installError = $_",
        "    try {",
        "        Restore-MuMuRegistryChanges",
        "    } catch {",
        "        Write-Warning \"MuMuPlayer Registry rollback failed: $($_.Exception.Message)\"",
        "    }",
        "    if (-not [string]::IsNullOrWhiteSpace($serviceSnapshot)) {",
        "        try {",
        "            Set-MuMuServiceImagePath $serviceSnapshot",
        "        } catch {",
        "            Write-Warning \"MuMuPlayer service path rollback failed: $($_.Exception.Message)\"",
        "        }",
        "    }",
        "    throw $installError",
        "} finally {",
        "    if ($stagingDir -and (Test-Path -LiteralPath $stagingDir)) {",
        "        Remove-Item -LiteralPath $stagingDir -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "    if (Test-Path -LiteralPath $sourceInstaller -PathType Leaf) {",
        "        Remove-Item -LiteralPath $sourceInstaller -Force -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "nx_main\\MuMuNxMain.exe",
            "MuMuPlayer"
        ]
    ],
    "persist": [
        "configs",
        "vms",
        "nx_device"
    ],
    "post_uninstall": [
        "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\MuMuPlayer\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$env:USERPROFILE\\Desktop\\MuMuPlayer.lnk\" -ErrorAction SilentlyContinue",
        "",
        "if ($cmd -eq 'uninstall' -and -not [string]::IsNullOrWhiteSpace($persist_dir)) {",
        "    $persistRoot = $persist_dir",
        "    $appRoot = Split-Path -Path $dir -Parent",
        "    $currentRoot = Join-Path $appRoot 'current'",
        "    $legacyRoot = Join-Path $persistRoot 'install'",
        "    $managedRoots = @($dir, $currentRoot, $legacyRoot)",
        "    $serviceName = 'MuMuPlayerRemoteService'",
        "",
        "    function Test-MuMuRootReference([string]$Text, [string[]]$Roots) {",
        "        if ([string]::IsNullOrWhiteSpace($Text)) { return $false }",
        "        foreach ($root in $Roots) {",
        "            if ([string]::IsNullOrWhiteSpace($root)) { continue }",
        "            $normalized = [IO.Path]::GetFullPath($root).TrimEnd('\\', '/')",
        "            $pattern = [regex]::Escape($normalized) + '(?=\\\\|/|[\"\\s,]|$)'",
        "            if ([regex]::IsMatch($Text, $pattern, [Text.RegularExpressions.RegexOptions]::IgnoreCase)) {",
        "                return $true",
        "            }",
        "        }",
        "        return $false",
        "    }",
        "",
        "    function Open-MuMuRegistryKey([string]$Path, [bool]$Writable) {",
        "        if ($Path -match '^HKLM:\\\\(.+)$') {",
        "            return [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($Matches[1], $Writable)",
        "        }",
        "        if ($Path -match '^HKCU:\\\\(.+)$') {",
        "            return [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey($Matches[1], $Writable)",
        "        }",
        "        throw \"Unsupported MuMuPlayer Registry path: $Path\"",
        "    }",
        "",
        "    if ($env:MUMU_SCOOP_TEST_MODE -eq '1') {",
        "        if (Test-MuMuRootReference ([string]$script:MockMuMuServicePath) $managedRoots) {",
        "            $script:MockMuMuServicePath = $null",
        "        }",
        "    } else {",
        "        $service = Get-CimInstance -ClassName Win32_Service -Filter \"Name='$serviceName'\" -ErrorAction SilentlyContinue",
        "        if ($service -and (Test-MuMuRootReference ([string]$service.PathName) $managedRoots)) {",
        "            if ($service.State -eq 'Running') {",
        "                Stop-Service -Name $serviceName -Force -ErrorAction Stop",
        "            }",
        "            $sc = Join-Path $env:SystemRoot 'System32\\sc.exe'",
        "            & $sc delete $serviceName | Out-Null",
        "            if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne 1072) {",
        "                throw \"Could not remove the MuMuPlayer service during Scoop uninstall. Exit code: $LASTEXITCODE\"",
        "            }",
        "        }",
        "    }",
        "",
        "    $registryPaths = if ($env:MUMU_SCOOP_TEST_MODE -eq '1') {",
        "        @($env:MUMU_SCOOP_TEST_REGISTRY_PATH)",
        "    } else {",
        "        @(",
        "            'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\MuMuPlayerGlobal',",
        "            'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\MuMuPlayerGlobal'",
        "        )",
        "    }",
        "",
        "    foreach ($registryPath in $registryPaths) {",
        "        if ([string]::IsNullOrWhiteSpace($registryPath)) { continue }",
        "        $key = Open-MuMuRegistryKey $registryPath $false",
        "        if ($null -eq $key) { continue }",
        "",
        "        $hasManagedReference = $false",
        "        try {",
        "            foreach ($name in $key.GetValueNames()) {",
        "                $value = $key.GetValue(",
        "                    $name,",
        "                    $null,",
        "                    [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames",
        "                )",
        "                if ($value -is [string] -and (Test-MuMuRootReference $value $managedRoots)) {",
        "                    $hasManagedReference = $true",
        "                    break",
        "                }",
        "            }",
        "        } finally {",
        "            $key.Close()",
        "        }",
        "",
        "        if ($hasManagedReference) {",
        "            Remove-Item -LiteralPath $registryPath -Recurse -Force -ErrorAction Stop",
        "        }",
        "    }",
        "",
        "    # Only detach persist junctions created by the old MuMuPlayer Scoop layout.",
        "    # Keep any unexpected files and all persistent user data.",
        "    if (Test-Path -LiteralPath $legacyRoot -PathType Container) {",
        "        $persistNames = @('configs', 'vms', 'nx_device')",
        "        foreach ($name in $persistNames) {",
        "            $junction = Join-Path $legacyRoot $name",
        "            $item = Get-Item -LiteralPath $junction -Force -ErrorAction SilentlyContinue",
        "            if (-not $item) { continue }",
        "",
        "            $expectedTarget = [IO.Path]::GetFullPath((Join-Path $persistRoot $name)).TrimEnd('\\')",
        "            $targets = @($item.Target)",
        "            if ($item.LinkType -ne 'Junction' -or $targets.Count -ne 1 -or",
        "                [IO.Path]::GetFullPath([string]$targets[0]).TrimEnd('\\') -ine $expectedTarget) {",
        "                throw \"Refusing to remove an unexpected path from the legacy MuMuPlayer root: $junction\"",
        "            }",
        "",
        "            [IO.Directory]::Delete($junction, $false)",
        "        }",
        "",
        "        if (@(Get-ChildItem -LiteralPath $legacyRoot -Force).Count -eq 0) {",
        "            Remove-Item -LiteralPath $legacyRoot -Force -ErrorAction Stop",
        "        } else {",
        "            Write-Warning \"Unexpected legacy MuMuPlayer files remain in '$legacyRoot'. They were retained; persisted user data was not removed.\"",
        "        }",
        "    }",
        "}"
    ],
    "checkver": {
        "script": [
            "$headers = @{ 'Accept' = 'application/vnd.github+json'; 'User-Agent' = 'Scoop-KiroBucket' }",
            "if (-not [string]::IsNullOrWhiteSpace($env:GITHUB_TOKEN)) { $headers['Authorization'] = \"Bearer $env:GITHUB_TOKEN\" }",
            "$releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/LOVECHEN/mumu-release/releases?per_page=100' -Headers $headers",
            "$asset = $null",
            "foreach ($release in $releases) {",
            "    $asset = $release.assets | Where-Object { $_.name -match '^MuMu-setup-nxmain-V[\\d.]+-overseas-[\\d]+\\.exe$' } | Select-Object -First 1",
            "    if ($asset) { break }",
            "}",
            "if (-not $asset) { throw 'No MuMuPlayer international NX-main installer asset was found in the GitHub releases API response.' }",
            "Write-Output $asset.name"
        ],
        "regex": "nxmain-V(?<version>[\\d.]+)-overseas-(?<build>[\\d]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://a11.gdl.easebar.com/MuMu-setup-nxmain-V$matchVersion-overseas-$matchBuild.exe"
            }
        }
    }
}
