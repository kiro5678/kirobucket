{
    "version": "1.8.16.6114",
    "description": "Android emulator for Windows (NX main engine); uses a stable persist install root for safe Scoop upgrades",
    "homepage": "https://www.mumuplayer.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://a11.gdl.easebar.com/MuMu-setup-nxmain-V1.8.16.6114-overseas-1119205802.exe",
            "hash": "16583e0f6c8d54e99ebc2926340bacf7b7dbca575919bf5adeba3e6d2d262c45"
        }
    },
    "pre_install": [
        "if (!(is_admin)) { throw \"MuMuPlayer requires administrator rights to install or update.\" }",
        "$ErrorActionPreference = 'Stop'",
        "if ([string]::IsNullOrWhiteSpace($persist_dir)) {",
        "    throw \"Scoop did not provide the resolved persist directory for $app.\"",
        "}",
        "",
        "$persistRoot = $persist_dir",
        "$stableRoot = Join-Path $persistRoot 'install'",
        "$persistNames = @('configs', 'vms', 'nx_device')",
        "$scoopAppRoot = Split-Path $dir -Parent",
        "$transactionId = [guid]::NewGuid().ToString()",
        "$rollbackRoot = Join-Path $persistRoot \".mumuplayer-rollback-$transactionId\"",
        "$sourceInstaller = Join-Path $dir $fname",
        "$stagingDir = $null",
        "$installerPath = $null",
        "$completed = $false",
        "$rollbackRetained = $false",
        "$script:fileBackups = New-Object System.Collections.ArrayList",
        "$script:registrySnapshots = New-Object System.Collections.ArrayList",
        "$script:serviceSnapshot = $null",
        "",
        "$registryPaths = if ($env:MUMU_SCOOP_TEST_MODE -eq '1') {",
        "    @($env:MUMU_SCOOP_TEST_REGISTRY_PATH)",
        "} else {",
        "    @(",
        "        'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\MuMuPlayerGlobal',",
        "        'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\MuMuPlayerGlobal'",
        "    )",
        "}",
        "$appDataConfigPaths = @(",
        "    (Join-Path $env:APPDATA 'Netease\\MuMuPlayerGlobal\\install_config.json'),",
        "    (Join-Path $env:ProgramData 'Netease\\MuMuPlayerGlobal\\install_config.json')",
        ") | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique",
        "",
        "$targetProductVersion = $null",
        "$previousProductVersion = $null",
        "$previousInstallDir = $null",
        "$appDataPreviousInstallDirs = @()",
        "$registeredInstallRoot = $null",
        "$sourceInstallRoot = $null",
        "$effectiveProductVersion = $null",
        "$serviceImageName = 'MuMuPlayerRemoteService'",
        "",
        "function Backup-MuMuFile([string]$Path) {",
        "    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return }",
        "    $fullPath = [IO.Path]::GetFullPath($Path)",
        "    foreach ($entry in @($script:fileBackups)) {",
        "        if ($entry.Path.Equals($fullPath, [StringComparison]::OrdinalIgnoreCase)) { return }",
        "    }",
        "    $backupDirectory = Join-Path $rollbackRoot 'files'",
        "    New-Item -ItemType Directory -Path $backupDirectory -Force | Out-Null",
        "    $backupPath = Join-Path $backupDirectory ([guid]::NewGuid().ToString('N') + '.bak')",
        "    Copy-Item -LiteralPath $fullPath -Destination $backupPath -Force",
        "    $script:fileBackups.Add([pscustomobject]@{",
        "        Path = $fullPath",
        "        Backup = $backupPath",
        "    }) | Out-Null",
        "}",
        "function Restore-MuMuFileBackups {",
        "    $errors = New-Object System.Collections.Generic.List[string]",
        "    foreach ($entry in @($script:fileBackups | Select-Object -Reverse)) {",
        "        try {",
        "            if (-not (Test-Path -LiteralPath $entry.Backup -PathType Leaf)) {",
        "                throw \"Backup file is missing: $($entry.Backup)\"",
        "            }",
        "            $parent = Split-Path -Path $entry.Path -Parent",
        "            New-Item -ItemType Directory -Path $parent -Force | Out-Null",
        "            Copy-Item -LiteralPath $entry.Backup -Destination $entry.Path -Force",
        "        } catch {",
        "            $errors.Add(\"$($entry.Path): $($_.Exception.Message)\")",
        "        }",
        "    }",
        "    if ($errors.Count -gt 0) {",
        "        throw \"One or more MuMuPlayer files could not be restored: $($errors -join '; ')\"",
        "    }",
        "}",
        "function Backup-MuMuRegistrySnapshot {",
        "    foreach ($path in $registryPaths) {",
        "        if ([string]::IsNullOrWhiteSpace($path)) { continue }",
        "        if (-not (Test-Path -LiteralPath $path)) {",
        "            $script:registrySnapshots.Add([pscustomobject]@{",
        "                Path = $path",
        "                Exists = $false",
        "                Values = @()",
        "            }) | Out-Null",
        "            continue",
        "        }",
        "        $key = Get-Item -LiteralPath $path -ErrorAction Stop",
        "        $values = foreach ($name in $key.GetValueNames()) {",
        "            [pscustomobject]@{",
        "                Name = $name",
        "                Value = $key.GetValue($name, $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)",
        "                Kind = $key.GetValueKind($name)",
        "            }",
        "        }",
        "        $script:registrySnapshots.Add([pscustomobject]@{",
        "            Path = $path",
        "            Exists = $true",
        "            Values = @($values)",
        "        }) | Out-Null",
        "    }",
        "}",
        "function Restore-MuMuRegistrySnapshot {",
        "    foreach ($snapshot in $script:registrySnapshots) {",
        "        if (-not $snapshot.Exists) {",
        "            if (Test-Path -LiteralPath $snapshot.Path) {",
        "                $key = Get-Item -LiteralPath $snapshot.Path -ErrorAction Stop",
        "                foreach ($name in @($key.GetValueNames())) {",
        "                    $key.DeleteValue($name, $false)",
        "                }",
        "                if ($key.GetSubKeyNames().Count -eq 0) {",
        "                    Remove-Item -LiteralPath $snapshot.Path -Force -ErrorAction SilentlyContinue",
        "                }",
        "            }",
        "            continue",
        "        }",
        "        if (-not (Test-Path -LiteralPath $snapshot.Path)) {",
        "            New-Item -ItemType RegistryKey -Path $snapshot.Path -Force | Out-Null",
        "        }",
        "        $key = Get-Item -LiteralPath $snapshot.Path -ErrorAction Stop",
        "        $originalNames = @($snapshot.Values | ForEach-Object { $_.Name })",
        "        foreach ($name in @($key.GetValueNames())) {",
        "            if ($originalNames -notcontains $name) {",
        "                $key.DeleteValue($name, $false)",
        "            }",
        "        }",
        "        foreach ($entry in $snapshot.Values) {",
        "            $key.SetValue($entry.Name, $entry.Value, $entry.Kind)",
        "        }",
        "        $key.Flush()",
        "    }",
        "}",
        "function Get-MuMuRegistryValue([string]$Name) {",
        "    foreach ($snapshot in $script:registrySnapshots) {",
        "        if (-not $snapshot.Exists) { continue }",
        "        foreach ($entry in $snapshot.Values) {",
        "            if ($entry.Name -ieq $Name) { return $entry.Value }",
        "        }",
        "    }",
        "    return $null",
        "}",
        "function Get-MuMuRegisteredInstallRoot {",
        "    $roots = New-Object System.Collections.Generic.List[string]",
        "    foreach ($snapshot in $script:registrySnapshots) {",
        "        if (-not $snapshot.Exists) { continue }",
        "        $uninstallValue = $null",
        "        $installLocation = $null",
        "        foreach ($entry in $snapshot.Values) {",
        "            if ($entry.Name -ieq 'UninstallString') { $uninstallValue = [string]$entry.Value }",
        "            if ($entry.Name -ieq 'InstallLocation') { $installLocation = [string]$entry.Value }",
        "        }",
        "        $executable = $null",
        "        if (-not [string]::IsNullOrWhiteSpace($uninstallValue)) {",
        "            $match = [regex]::Match($uninstallValue, '^\\s*\"(?<exe>[^\"]+\\.exe)\"', [Text.RegularExpressions.RegexOptions]::IgnoreCase)",
        "            if (-not $match.Success) {",
        "                $match = [regex]::Match($uninstallValue, '^\\s*(?<exe>.+?\\.exe)(?:\\s|$)', [Text.RegularExpressions.RegexOptions]::IgnoreCase)",
        "            }",
        "            if ($match.Success) { $executable = [Environment]::ExpandEnvironmentVariables($match.Groups['exe'].Value) }",
        "        }",
        "        $candidate = $null",
        "        if ($executable) {",
        "            if (Test-Path -LiteralPath $executable -PathType Leaf) {",
        "                $candidate = Split-Path -Path $executable -Parent",
        "            }",
        "        }",
        "        if (-not $candidate -and -not [string]::IsNullOrWhiteSpace($installLocation)) {",
        "            $installLocation = [Environment]::ExpandEnvironmentVariables($installLocation)",
        "            if (Test-Path -LiteralPath $installLocation -PathType Container) { $candidate = $installLocation }",
        "        }",
        "        if ($candidate) { $roots.Add([IO.Path]::GetFullPath($candidate)) }",
        "    }",
        "    $unique = @($roots | Select-Object -Unique)",
        "    if ($unique.Count -gt 1) {",
        "        throw \"MuMuPlayer uninstall registrations point to conflicting install roots: $($unique -join '; '). No path was changed.\"",
        "    }",
        "    if ($unique.Count -eq 1) { return $unique[0] }",
        "    return $null",
        "}",
        "function Backup-MuMuServiceSnapshot {",
        "    if ($env:MUMU_SCOOP_TEST_MODE -eq '1') {",
        "        $script:serviceSnapshot = [pscustomobject]@{",
        "            Exists = -not [string]::IsNullOrWhiteSpace($script:MockMuMuServicePath)",
        "            PathName = $script:MockMuMuServicePath",
        "        }",
        "        return",
        "    }",
        "    $service = Get-CimInstance -ClassName Win32_Service -Filter \"Name='$serviceImageName'\" -ErrorAction SilentlyContinue",
        "    if ($service) {",
        "        $script:serviceSnapshot = [pscustomobject]@{",
        "            Exists = $true",
        "            PathName = [string]$service.PathName",
        "        }",
        "    } else {",
        "        $script:serviceSnapshot = [pscustomobject]@{ Exists = $false; PathName = $null }",
        "    }",
        "}",
        "function Set-MuMuServiceImagePath([string]$PathName) {",
        "    if ($env:MUMU_SCOOP_TEST_MODE -eq '1') {",
        "        $script:MockMuMuServicePath = $PathName",
        "        return",
        "    }",
        "    $sc = Join-Path $env:SystemRoot 'System32\\sc.exe'",
        "    & $sc config $serviceImageName binPath= $PathName | Out-Null",
        "    if ($LASTEXITCODE -ne 0) {",
        "        throw \"Could not update the $serviceImageName service image path. sc.exe exit code: $LASTEXITCODE\"",
        "    }",
        "}",
        "function Restore-MuMuServiceSnapshot {",
        "    if ($script:serviceSnapshot -and $script:serviceSnapshot.Exists) {",
        "        Set-MuMuServiceImagePath $script:serviceSnapshot.PathName",
        "    }",
        "}",
        "function Set-MuMuServicePath([string]$OldRoot, [string]$NewRoot) {",
        "    if ($env:MUMU_SCOOP_TEST_MODE -eq '1') {",
        "        if ([string]::IsNullOrWhiteSpace($script:MockMuMuServicePath)) { return }",
        "        if (-not [string]::IsNullOrWhiteSpace($OldRoot)) {",
        "            $script:MockMuMuServicePath = [regex]::Replace(",
        "                $script:MockMuMuServicePath,",
        "                [regex]::Escape($OldRoot.TrimEnd('\\', '/')),",
        "                [Text.RegularExpressions.MatchEvaluator]{ param($match) $NewRoot.TrimEnd('\\', '/') },",
        "                [Text.RegularExpressions.RegexOptions]::IgnoreCase",
        "            )",
        "        }",
        "        return",
        "    }",
        "    $service = Get-CimInstance -ClassName Win32_Service -Filter \"Name='$serviceImageName'\" -ErrorAction SilentlyContinue",
        "    if (-not $service) { return }",
        "    $current = [string]$service.PathName",
        "    if ([string]::IsNullOrWhiteSpace($current) -or [string]::IsNullOrWhiteSpace($OldRoot)) { return }",
        "    $updated = [regex]::Replace(",
        "        $current,",
        "        [regex]::Escape($OldRoot.TrimEnd('\\', '/')),",
        "        [Text.RegularExpressions.MatchEvaluator]{ param($match) $NewRoot.TrimEnd('\\', '/') },",
        "        [Text.RegularExpressions.RegexOptions]::IgnoreCase",
        "    )",
        "    if ($updated -ne $current) { Set-MuMuServiceImagePath $updated }",
        "}",
        "function Replace-MuMuRootInText([string]$Text, [string]$OldRoot, [string]$NewRoot) {",
        "    if ([string]::IsNullOrWhiteSpace($OldRoot) -or [string]::IsNullOrWhiteSpace($NewRoot)) { return $Text }",
        "    $old = $OldRoot.TrimEnd('\\', '/')",
        "    $new = $NewRoot.TrimEnd('\\', '/')",
        "    if ($old.Equals($new, [StringComparison]::OrdinalIgnoreCase)) { return $Text }",
        "    $oldEscaped = $old.Replace('\\', '\\\\')",
        "    $newEscaped = $new.Replace('\\', '\\\\')",
        "    $oldForward = $old.Replace('\\', '/')",
        "    $newForward = $new.Replace('\\', '/')",
        "    $result = [regex]::Replace($Text, [regex]::Escape($oldEscaped), [Text.RegularExpressions.MatchEvaluator]{ param($match) $newEscaped }, [Text.RegularExpressions.RegexOptions]::IgnoreCase)",
        "    $result = [regex]::Replace($result, [regex]::Escape($oldForward), [Text.RegularExpressions.MatchEvaluator]{ param($match) $newForward }, [Text.RegularExpressions.RegexOptions]::IgnoreCase)",
        "    return [regex]::Replace($result, [regex]::Escape($old), [Text.RegularExpressions.MatchEvaluator]{ param($match) $new }, [Text.RegularExpressions.RegexOptions]::IgnoreCase)",
        "}",
        "function Update-MuMuStoredPaths([string]$OldRoot, [string]$NewRoot) {",
        "    if ([string]::IsNullOrWhiteSpace($OldRoot) -or [string]::IsNullOrWhiteSpace($NewRoot)) { return }",
        "    $extensions = @('.json', '.vbox', '.vbox-prev', '.nemu', '.xml', '.ini', '.cfg', '.conf')",
        "    foreach ($name in $persistNames) {",
        "        $root = Join-Path $persistRoot $name",
        "        if (-not (Test-Path -LiteralPath $root -PathType Container)) { continue }",
        "        $files = @(Get-ChildItem -LiteralPath $root -Recurse -File -Force -ErrorAction Stop |",
        "            Where-Object { ($extensions -contains $_.Extension.ToLowerInvariant()) -and $_.Length -le 8MB })",
        "        foreach ($file in $files) {",
        "            $bytes = [IO.File]::ReadAllBytes($file.FullName)",
        "            $encoding = New-Object Text.UTF8Encoding($false)",
        "            if ($bytes.Length -ge 2 -and $bytes[0] -eq 0xFF -and $bytes[1] -eq 0xFE) {",
        "                $encoding = [Text.Encoding]::Unicode",
        "            } elseif ($bytes.Length -ge 2 -and $bytes[0] -eq 0xFE -and $bytes[1] -eq 0xFF) {",
        "                $encoding = [Text.Encoding]::BigEndianUnicode",
        "            } elseif ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) {",
        "                $encoding = New-Object Text.UTF8Encoding($true)",
        "            }",
        "            $raw = [IO.File]::ReadAllText($file.FullName, $encoding)",
        "            $updated = Replace-MuMuRootInText $raw $OldRoot $NewRoot",
        "            if ($updated -ne $raw) {",
        "                Backup-MuMuFile $file.FullName",
        "                $temporary = \"$($file.FullName).kirobucket-$transactionId.tmp\"",
        "                [IO.File]::WriteAllText($temporary, $updated, $encoding)",
        "                Move-Item -LiteralPath $temporary -Destination $file.FullName -Force",
        "                Write-Host \"Updated MuMuPlayer path in $($file.FullName)\"",
        "            }",
        "        }",
        "    }",
        "}",
        "function Set-MuMuInstallConfigPaths {",
        "    param(",
        "        [string]$Path,",
        "        [switch]$UpdateVersion",
        "    )",
        "    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return }",
        "    $cfg = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop",
        "    $changed = $false",
        "    if ($cfg.product -and $cfg.product.PSObject.Properties['install_dir']) {",
        "        if ([string]$cfg.product.install_dir -ine $stableRoot) {",
        "            $cfg.product.install_dir = $stableRoot",
        "            $changed = $true",
        "        }",
        "    }",
        "    if ($UpdateVersion -and $cfg.product -and $cfg.product.PSObject.Properties['version']) {",
        "        if ([string]$cfg.product.version -ine $effectiveProductVersion) {",
        "            $cfg.product.version = $effectiveProductVersion",
        "            $changed = $true",
        "        }",
        "    }",
        "    if ($cfg.main -and $cfg.main.PSObject.Properties['install_dir']) {",
        "        $mainRoot = Join-Path $stableRoot 'nx_main'",
        "        if ([string]$cfg.main.install_dir -ine $mainRoot) {",
        "            $cfg.main.install_dir = $mainRoot",
        "            $changed = $true",
        "        }",
        "    }",
        "    if ($cfg.engines) {",
        "        foreach ($property in $cfg.engines.PSObject.Properties) {",
        "            $engineName = $property.Name",
        "            $engine = $property.Value",
        "            $engineVersionDir = if ($engineName -eq 'nemux') { '12.0' } else { '15.0' }",
        "            $engineRoot = Join-Path $stableRoot \"nx_device\\$engineVersionDir\"",
        "            if ($engine.player -and $engine.player.PSObject.Properties['install_dir']) {",
        "                $pathValue = Join-Path $engineRoot 'shell'",
        "                if ([string]$engine.player.install_dir -ine $pathValue) {",
        "                    $engine.player.install_dir = $pathValue",
        "                    $changed = $true",
        "                }",
        "            }",
        "            if ($engine.vms -and $engine.vms.PSObject.Properties['install_dir']) {",
        "                $pathValue = Join-Path $stableRoot 'vms'",
        "                if ([string]$engine.vms.install_dir -ine $pathValue) {",
        "                    $engine.vms.install_dir = $pathValue",
        "                    $changed = $true",
        "                }",
        "            }",
        "            if ($engine.renderer -and $engine.renderer.PSObject.Properties['install_dir']) {",
        "                $pathValue = Join-Path $engineRoot 'device'",
        "                if ([string]$engine.renderer.install_dir -ine $pathValue) {",
        "                    $engine.renderer.install_dir = $pathValue",
        "                    $changed = $true",
        "                }",
        "            }",
        "        }",
        "    }",
        "    if ($changed) {",
        "        Backup-MuMuFile $Path",
        "        $temporary = \"$Path.kirobucket-$transactionId.tmp\"",
        "        [IO.File]::WriteAllText($temporary, ($cfg | ConvertTo-Json -Depth 32), (New-Object Text.UTF8Encoding($false)))",
        "        Move-Item -LiteralPath $temporary -Destination $Path -Force",
        "    }",
        "}",
        "function New-MuMuStablePersistJunction([string]$Name) {",
        "    $source = Join-Path $stableRoot $Name",
        "    $target = Join-Path $persistRoot $Name",
        "    New-Item -ItemType Directory -Path $target -Force | Out-Null",
        "    if (Test-Path -LiteralPath $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.LinkType -eq 'Junction') {",
        "            $existingTarget = [IO.Path]::GetFullPath([string]$item.Target).TrimEnd('\\')",
        "            $expectedTarget = [IO.Path]::GetFullPath($target).TrimEnd('\\')",
        "            if ($existingTarget -ieq $expectedTarget) { return }",
        "        }",
        "        throw \"Refusing to replace an existing non-matching path in the stable MuMuPlayer root: $source\"",
        "    }",
        "    New-Item -ItemType Junction -Path $source -Value $target | Out-Null",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if (-not ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "        throw \"Failed to create the stable MuMuPlayer persist junction: $source\"",
        "    }",
        "}",
        "function Copy-MuMuInstallRootToStable([string]$SourceRoot) {",
        "    New-Item -ItemType Directory -Path $stableRoot -Force | Out-Null",
        "    if ([string]::IsNullOrWhiteSpace($SourceRoot)) { return }",
        "    $sourceFull = [IO.Path]::GetFullPath($SourceRoot).TrimEnd('\\')",
        "    $stableFull = [IO.Path]::GetFullPath($stableRoot).TrimEnd('\\')",
        "    if ($sourceFull -ieq $stableFull) { return }",
        "    if (-not (Test-Path -LiteralPath $sourceFull -PathType Container)) {",
        "        throw \"The registered MuMuPlayer installation directory does not exist: $sourceFull\"",
        "    }",
        "    $mainExe = Join-Path $sourceFull 'nx_main\\MuMuNxMain.exe'",
        "    $uninstaller = Join-Path $sourceFull 'uninstall.exe'",
        "    if (-not (Test-Path -LiteralPath $mainExe -PathType Leaf) -or",
        "        -not (Test-Path -LiteralPath $uninstaller -PathType Leaf)) {",
        "        throw \"The registered MuMuPlayer root is incomplete; expected nx_main\\MuMuNxMain.exe and uninstall.exe: $sourceFull\"",
        "    }",
        "    $excludeDirs = @('.txn', '.backup') + $persistNames",
        "    $excludePaths = @($excludeDirs | ForEach-Object { Join-Path $sourceFull $_ })",
        "    $robocopy = Join-Path $env:SystemRoot 'System32\\robocopy.exe'",
        "    $arguments = @(",
        "        $sourceFull,",
        "        $stableFull,",
        "        '*.*',",
        "        '/E',",
        "        '/COPY:DAT',",
        "        '/DCOPY:DAT',",
        "        '/XJ',",
        "        '/R:2',",
        "        '/W:1',",
        "        '/IS',",
        "        '/IT',",
        "        '/NFL',",
        "        '/NDL',",
        "        '/NJH',",
        "        '/NJS',",
        "        '/NP',",
        "        '/XD'",
        "    ) + $excludePaths",
        "    & $robocopy @arguments | Out-Null",
        "    $copyExitCode = $LASTEXITCODE",
        "    if ($copyExitCode -ge 8) {",
        "        throw \"Could not copy the existing MuMuPlayer files to the stable persist root. Robocopy exit code: $copyExitCode\"",
        "    }",
        "    if (-not (Test-Path -LiteralPath (Join-Path $stableFull 'nx_main\\MuMuNxMain.exe') -PathType Leaf) -or",
        "        -not (Test-Path -LiteralPath (Join-Path $stableFull 'uninstall.exe') -PathType Leaf)) {",
        "        throw \"The stable MuMuPlayer root copy is incomplete: $stableFull\"",
        "    }",
        "}",
        "function Update-MuMuUninstallRegistration([string[]]$OldRoots, [string]$NewRoot) {",
        "    foreach ($snapshot in $script:registrySnapshots) {",
        "        if (-not $snapshot.Exists) { continue }",
        "        $key = Get-Item -LiteralPath $snapshot.Path -ErrorAction Stop",
        "        foreach ($name in $key.GetValueNames()) {",
        "            $value = $key.GetValue($name, $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)",
        "            if ($value -isnot [string]) { continue }",
        "            $updated = $value",
        "            foreach ($oldRoot in $OldRoots) {",
        "                if (-not [string]::IsNullOrWhiteSpace($oldRoot)) {",
        "                    $updated = Replace-MuMuRootInText $updated $oldRoot $NewRoot",
        "                }",
        "            }",
        "            if ($name -ieq 'InstallLocation' -and -not [string]::IsNullOrWhiteSpace([string]$value)) {",
        "                $updated = $NewRoot",
        "            }",
        "            if ($updated -ne $value) {",
        "                $kind = $key.GetValueKind($name)",
        "                $key.SetValue($name, $updated, $kind)",
        "            }",
        "        }",
        "        $key.Flush()",
        "    }",
        "}",
        "function Get-MuMuInstallConfig {",
        "    $path = Join-Path $persistRoot 'configs\\main\\install_config.json'",
        "    if (-not (Test-Path -LiteralPath $path -PathType Leaf)) { return $null }",
        "    try {",
        "        return (Get-Content -LiteralPath $path -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop)",
        "    } catch {",
        "        throw \"Existing MuMuPlayer install_config.json is not valid JSON. It was left untouched: $path. $($_.Exception.Message)\"",
        "    }",
        "}",
        "function Get-MuMuProductVersion {",
        "    $cfg = Get-MuMuInstallConfig",
        "    if ($cfg -and $cfg.product -and $cfg.product.version) { return [string]$cfg.product.version }",
        "    return $null",
        "}",
        "function Test-MuMuVersionGreater([string]$Left, [string]$Right) {",
        "    try { return ([version]$Left -gt [version]$Right) }",
        "    catch { return ($Left -ne $Right) }",
        "}",
        "function Get-MuMuInstallFingerprint {",
        "    $parts = New-Object System.Collections.Generic.List[string]",
        "    $roots = @(",
        "        [pscustomobject]@{ Label = 'persist\\configs'; Path = (Join-Path $persistRoot 'configs') },",
        "        [pscustomobject]@{ Label = 'stable\\nx_main'; Path = (Join-Path $stableRoot 'nx_main') },",
        "        [pscustomobject]@{ Label = 'persist\\nx_device'; Path = (Join-Path $persistRoot 'nx_device') },",
        "        [pscustomobject]@{ Label = 'stable\\.txn'; Path = (Join-Path $stableRoot '.txn') }",
        "    )",
        "    foreach ($entry in $roots) {",
        "        $root = $entry.Path",
        "        if (-not (Test-Path -LiteralPath $root -PathType Container)) { continue }",
        "        foreach ($file in @(Get-ChildItem -LiteralPath $root -Recurse -File -Force -ErrorAction SilentlyContinue | Sort-Object FullName)) {",
        "            $relative = $file.FullName.Substring($root.Length).TrimStart('\\')",
        "            $parts.Add(('{0}\\{1}|{2}|{3}' -f $entry.Label, $relative, $file.Length, $file.LastWriteTimeUtc.Ticks))",
        "        }",
        "    }",
        "    return [string]::Join('|', $parts)",
        "}",
        "function Wait-ForMuMuInstallStability([string]$Phase, [int]$TimeoutSeconds = 300) {",
        "    $deadline = [DateTime]::UtcNow.AddSeconds($TimeoutSeconds)",
        "    $previous = $null",
        "    $stableSamples = 0",
        "    while ([DateTime]::UtcNow -lt $deadline) {",
        "        $current = Get-MuMuInstallFingerprint",
        "        if ($null -ne $previous -and $current -ceq $previous) {",
        "            $stableSamples++",
        "            if ($stableSamples -ge 6) { return }",
        "        } else {",
        "            $stableSamples = 0",
        "        }",
        "        $previous = $current",
        "        Start-Sleep -Milliseconds 500",
        "    }",
        "    throw \"MuMuPlayer $Phase output did not become stable within $TimeoutSeconds seconds.\"",
        "}",
        "function Invoke-MuMuInstallerPhase([string]$Action, [string]$Txn, [string]$ProductVersion) {",
        "    $arguments = @(",
        "        '/from_orchestrator=1',",
        "        \"/action=$Action\",",
        "        \"/txn_id=$Txn\",",
        "        '/silent=1',",
        "        \"/product_version=$ProductVersion\",",
        "        '/auto_start=false',",
        "        '/fchannel=gw-win-download',",
        "        '/auto_run=false',",
        "        ('/D=' + $stableRoot)",
        "    )",
        "    $process = Start-Process -FilePath $installerPath -ArgumentList $arguments -Wait -PassThru -WindowStyle Hidden",
        "    if ($null -eq $process) { throw \"MuMuPlayer $Action could not be started.\" }",
        "    return [int]$process.ExitCode",
        "}",
        "",
        "try {",
        "    if (-not (Test-Path -LiteralPath $sourceInstaller -PathType Leaf)) {",
        "        throw \"MuMuPlayer installer was not found: $sourceInstaller\"",
        "    }",
        "    $downloadUrl = \"https://a11.gdl.easebar.com/$fname\"",
        "    $cachedInstaller = cache_path $app $version $downloadUrl",
        "    if (Test-Path -LiteralPath $cachedInstaller -PathType Leaf) {",
        "        $installerPath = $cachedInstaller",
        "        Remove-Item -LiteralPath $sourceInstaller -Force",
        "    } else {",
        "        $scoopRoot = Split-Path (Split-Path (Split-Path $dir -Parent) -Parent) -Parent",
        "        $stagingDir = Join-Path $scoopRoot \"cache\\mumuplayer-installer-$transactionId\"",
        "        New-Item -ItemType Directory -Path $stagingDir -Force | Out-Null",
        "        $installerPath = Join-Path $stagingDir $fname",
        "        Copy-Item -LiteralPath $sourceInstaller -Destination $installerPath -Force",
        "        Remove-Item -LiteralPath $sourceInstaller -Force",
        "    }",
        "    $remainingFiles = @(Get-ChildItem -LiteralPath $dir -Force)",
        "    if ($remainingFiles.Count -gt 0) {",
        "        throw \"MuMuPlayer target directory must be empty before setup. Unexpected item: $($remainingFiles[0].FullName)\"",
        "    }",
        "",
        "    $runningNames = @(",
        "        'MuMuNxMain', 'MuMuNxLauncher', 'MuMuNxService', 'MuMuManager',",
        "        'MuMuNxDevice', 'MuMuNxSVC', 'MuMuNxHeadless', 'MuMuVMMHeadless',",
        "        'MuMuVMMSVC', 'MuMuVMMManage', 'MuMuPlayerRemoteService',",
        "        'MuMuPlayerRemoteBackend', 'MuMuPlayerRemoteHealthd'",
        "    )",
        "    $running = @(Get-Process -Name $runningNames -ErrorAction SilentlyContinue)",
        "    if ($running.Count -gt 0) {",
        "        $names = ($running | Select-Object -ExpandProperty ProcessName -Unique) -join ', '",
        "        throw \"Close MuMuPlayer before updating. Running processes: $names\"",
        "    }",
        "",
        "    $versionParts = $version -split '\\.'",
        "    if ($versionParts.Count -lt 3) {",
        "        throw \"Cannot derive MuMuPlayer product version from NX-main version '$version'.\"",
        "    }",
        "    $targetProductVersion = \"6.$($versionParts[1]).$($versionParts[2]).0\"",
        "",
        "    New-Item -ItemType Directory -Path $persistRoot -Force | Out-Null",
        "    Backup-MuMuRegistrySnapshot",
        "    Backup-MuMuServiceSnapshot",
        "",
        "    $oldConfig = Get-MuMuInstallConfig",
        "    if ($oldConfig -and $oldConfig.product) {",
        "        if ($oldConfig.product.version) { $previousProductVersion = [string]$oldConfig.product.version }",
        "        if ($oldConfig.product.install_dir) { $previousInstallDir = [string]$oldConfig.product.install_dir }",
        "    }",
        "    foreach ($configPath in $appDataConfigPaths) {",
        "        if (-not (Test-Path -LiteralPath $configPath -PathType Leaf)) { continue }",
        "        $appConfig = Get-Content -LiteralPath $configPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop",
        "        if ($appConfig.product -and $appConfig.product.install_dir) {",
        "            $appDataPreviousInstallDirs += [string]$appConfig.product.install_dir",
        "        }",
        "        if (-not $previousProductVersion -and $appConfig.product -and $appConfig.product.version) {",
        "            $previousProductVersion = [string]$appConfig.product.version",
        "        }",
        "    }",
        "    $registeredInstallRoot = Get-MuMuRegisteredInstallRoot",
        "    $sourceInstallRoot = $registeredInstallRoot",
        "    if (-not $sourceInstallRoot) {",
        "        if ($previousInstallDir -and (Test-Path -LiteralPath $previousInstallDir -PathType Container)) {",
        "            $sourceInstallRoot = $previousInstallDir",
        "        } else {",
        "            $candidate = $appDataPreviousInstallDirs | Where-Object { Test-Path -LiteralPath $_ -PathType Container } | Select-Object -First 1",
        "            if ($candidate) { $sourceInstallRoot = $candidate }",
        "        }",
        "    }",
        "    if ($sourceInstallRoot) {",
        "        $sourceFull = [IO.Path]::GetFullPath($sourceInstallRoot).TrimEnd('\\')",
        "        $stableFull = [IO.Path]::GetFullPath($stableRoot).TrimEnd('\\')",
        "        $appPrefix = [IO.Path]::GetFullPath($scoopAppRoot).TrimEnd('\\') + '\\'",
        "        if ($sourceFull -ine $stableFull -and",
        "            -not $sourceFull.StartsWith($appPrefix, [StringComparison]::OrdinalIgnoreCase)) {",
        "            throw \"The registered MuMuPlayer root is outside this Scoop app directory. Refusing to migrate or modify another installation: $sourceFull\"",
        "        }",
        "        if ($sourceFull -ieq [IO.Path]::GetFullPath($dir).TrimEnd('\\')) {",
        "            throw \"MuMuPlayer is registered in the new empty Scoop version directory. Refusing to overwrite a root that is not an existing completed installation: $sourceFull\"",
        "        }",
        "    } elseif (Test-Path -LiteralPath (Join-Path $stableRoot 'nx_main\\MuMuNxMain.exe') -PathType Leaf) {",
        "        $sourceInstallRoot = $stableRoot",
        "    }",
        "",
        "    Copy-MuMuInstallRootToStable $sourceInstallRoot",
        "    foreach ($name in $persistNames) {",
        "        New-Item -ItemType Directory -Path (Join-Path $persistRoot $name) -Force | Out-Null",
        "        New-MuMuStablePersistJunction $name",
        "    }",
        "",
        "    if ($previousProductVersion -and (Test-MuMuVersionGreater $targetProductVersion $previousProductVersion)) {",
        "        Write-Host \"MuMuPlayer upgrade: $previousProductVersion -> $targetProductVersion\"",
        "    } elseif ($previousProductVersion) {",
        "        Write-Host \"MuMuPlayer product version recorded in persistent config: $previousProductVersion\"",
        "    }",
        "",
        "    $rootsToMigrate = @($registeredInstallRoot, $previousInstallDir) + @($appDataPreviousInstallDirs) + @($sourceInstallRoot)",
        "    foreach ($oldRoot in @($rootsToMigrate | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique)) {",
        "        Update-MuMuStoredPaths $oldRoot $stableRoot",
        "        Set-MuMuServicePath $oldRoot $stableRoot",
        "    }",
        "    Update-MuMuUninstallRegistration $rootsToMigrate $stableRoot",
        "    $persistInstallConfig = Join-Path $persistRoot 'configs\\main\\install_config.json'",
        "    Set-MuMuInstallConfigPaths -Path $persistInstallConfig",
        "    foreach ($configPath in $appDataConfigPaths) {",
        "        Set-MuMuInstallConfigPaths -Path $configPath",
        "    }",
        "",
        "    $effectiveProductVersion = $targetProductVersion",
        "    $prepareExitCode = Invoke-MuMuInstallerPhase 'install_prepare' $transactionId $effectiveProductVersion",
        "",
        "    if ($prepareExitCode -eq 80002) {",
        "        if ([string]::IsNullOrWhiteSpace($previousProductVersion)) {",
        "            throw \"MuMuPlayer returned error 80002, which its official help describes as a higher local version. No trusted product version exists in persisted or AppData config. The script will not delete or rename '$env:PUBLIC\\.MUMUVMM' automatically.\"",
        "        }",
        "        if (Test-MuMuVersionGreater $previousProductVersion $targetProductVersion) {",
        "            throw \"MuMuPlayer returned error 80002 and the recorded product version '$previousProductVersion' is newer than requested '$targetProductVersion'. Refusing to downgrade or overwrite the newer installation.\"",
        "        }",
        "        if ($previousProductVersion -eq $targetProductVersion) {",
        "            throw \"MuMuPlayer returned error 80002 although the recorded product version already equals '$targetProductVersion'. Check for a separate MuMu installation or stale '%PUBLIC%\\.MUMUVMM' record; no data was deleted.\"",
        "        }",
        "        $staleTransaction = Join-Path $stableRoot \".txn\\$transactionId\"",
        "        if (Test-Path -LiteralPath $staleTransaction) {",
        "            Remove-Item -LiteralPath $staleTransaction -Recurse -Force",
        "        }",
        "        Write-Warning \"MuMuPlayer rejected the derived product version with 80002. Retrying once with the existing product version '$previousProductVersion'.\"",
        "        $transactionId = [guid]::NewGuid().ToString()",
        "        $effectiveProductVersion = $previousProductVersion",
        "        $prepareExitCode = Invoke-MuMuInstallerPhase 'install_prepare' $transactionId $effectiveProductVersion",
        "    }",
        "    if ($prepareExitCode -ne 0) {",
        "        throw \"MuMuPlayer install_prepare failed with exit code $prepareExitCode.\"",
        "    }",
        "    Wait-ForMuMuInstallStability 'install_prepare'",
        "",
        "    $preparedProductVersion = Get-MuMuProductVersion",
        "    $commitExitCode = Invoke-MuMuInstallerPhase 'commit' $transactionId $effectiveProductVersion",
        "    if ($commitExitCode -eq 80002 -and",
        "        $preparedProductVersion -and",
        "        $preparedProductVersion -ne $effectiveProductVersion -and",
        "        -not (Test-MuMuVersionGreater $preparedProductVersion $targetProductVersion)) {",
        "        Write-Warning \"MuMuPlayer commit returned 80002. Retrying once with the product version written by install_prepare: '$preparedProductVersion'.\"",
        "        $effectiveProductVersion = $preparedProductVersion",
        "        $commitExitCode = Invoke-MuMuInstallerPhase 'commit' $transactionId $effectiveProductVersion",
        "    }",
        "    if ($commitExitCode -ne 0) {",
        "        throw \"MuMuPlayer commit failed with exit code $commitExitCode.\"",
        "    }",
        "    Wait-ForMuMuInstallStability 'commit'",
        "",
        "    $mainExe = Join-Path $stableRoot 'nx_main\\MuMuNxMain.exe'",
        "    if (-not (Test-Path -LiteralPath $mainExe -PathType Leaf)) {",
        "        throw \"MuMuPlayer setup returned success but the expected executable was not created: $mainExe\"",
        "    }",
        "    $uninstaller = Join-Path $stableRoot 'uninstall.exe'",
        "    if (-not (Test-Path -LiteralPath $uninstaller -PathType Leaf)) {",
        "        throw \"MuMuPlayer setup returned success but the expected uninstaller was not created: $uninstaller\"",
        "    }",
        "",
        "    Update-MuMuUninstallRegistration $rootsToMigrate $stableRoot",
        "    foreach ($oldRoot in @($rootsToMigrate | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique)) {",
        "        Set-MuMuServicePath $oldRoot $stableRoot",
        "    }",
        "    Set-MuMuInstallConfigPaths -Path $persistInstallConfig -UpdateVersion",
        "    foreach ($configPath in $appDataConfigPaths) {",
        "        Set-MuMuInstallConfigPaths -Path $configPath -UpdateVersion",
        "    }",
        "",
        "    $launcherPath = Join-Path $dir 'MuMuPlayer.cmd'",
        "    $launcherLines = @(",
        "        '@echo off',",
        "        ('set \"MUMU_INSTALL_DIR=' + $stableRoot + '\"'),",
        "        'if not exist \"%MUMU_INSTALL_DIR%\\nx_main\\MuMuNxMain.exe\" exit /b 1',",
        "        'pushd \"%MUMU_INSTALL_DIR%\\nx_main\"',",
        "        'if errorlevel 1 exit /b 1',",
        "        '\"%MUMU_INSTALL_DIR%\\nx_main\\MuMuNxMain.exe\" %*',",
        "        'set \"MUMU_EXIT=%ERRORLEVEL%\"',",
        "        'popd',",
        "        'exit /b %MUMU_EXIT%'",
        "    )",
        "    [IO.File]::WriteAllLines($launcherPath, $launcherLines, (New-Object Text.UTF8Encoding($false)))",
        "",
        "    $completed = $true",
        "}",
        "catch {",
        "    $installError = $_",
        "    $rollbackErrors = New-Object System.Collections.Generic.List[string]",
        "    try { Restore-MuMuFileBackups } catch { $rollbackErrors.Add($_.Exception.Message) }",
        "    try { Restore-MuMuRegistrySnapshot } catch { $rollbackErrors.Add($_.Exception.Message) }",
        "    try { Restore-MuMuServiceSnapshot } catch { $rollbackErrors.Add($_.Exception.Message) }",
        "    if ($rollbackErrors.Count -gt 0) {",
        "        $rollbackRetained = $true",
        "        Write-Warning \"MuMuPlayer rollback was incomplete. Do not delete this recovery folder: $rollbackRoot\"",
        "        throw \"MuMuPlayer upgrade failed: $($installError.Exception.Message) Rollback also reported: $($rollbackErrors -join '; '). Recovery copies were retained at: $rollbackRoot\"",
        "    }",
        "    if (Test-Path -LiteralPath $rollbackRoot) {",
        "        Remove-Item -LiteralPath $rollbackRoot -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "    throw $installError",
        "}",
        "finally {",
        "    if ($stagingDir -and (Test-Path -LiteralPath $stagingDir)) {",
        "        Remove-Item -LiteralPath $stagingDir -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "    if (Test-Path -LiteralPath $sourceInstaller -PathType Leaf) {",
        "        Remove-Item -LiteralPath $sourceInstaller -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "if (-not $completed) {",
        "    throw 'MuMuPlayer installation did not complete.'",
        "}",
        "if (Test-Path -LiteralPath $rollbackRoot) {",
        "    Remove-Item -LiteralPath $rollbackRoot -Recurse -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "shortcuts": [
        [
            "MuMuPlayer.cmd",
            "MuMuPlayer"
        ]
    ],
    "persist": [
        "configs",
        "vms",
        "nx_device"
    ],
    "post_uninstall": [
        "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\MuMuPlayer\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$env:USERPROFILE\\Desktop\\MuMuPlayer.lnk\" -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "script": [
            "$headers = @{ 'Accept' = 'application/vnd.github+json'; 'User-Agent' = 'Scoop-KiroBucket' }",
            "if (-not [string]::IsNullOrWhiteSpace($env:GITHUB_TOKEN)) { $headers['Authorization'] = \"Bearer $env:GITHUB_TOKEN\" }",
            "$releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/LOVECHEN/mumu-release/releases?per_page=100' -Headers $headers",
            "$asset = $null",
            "foreach ($release in $releases) {",
            "    $asset = $release.assets | Where-Object { $_.name -match '^MuMu-setup-nxmain-V[\\d.]+-overseas-[\\d]+\\.exe$' } | Select-Object -First 1",
            "    if ($asset) { break }",
            "}",
            "if (-not $asset) { throw 'No MuMuPlayer international NX-main installer asset was found in the GitHub releases API response.' }",
            "Write-Output $asset.name"
        ],
        "regex": "nxmain-V(?<version>[\\d.]+)-overseas-(?<build>[\\d]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://a11.gdl.easebar.com/MuMu-setup-nxmain-V$matchVersion-overseas-$matchBuild.exe"
            }
        }
    }
}
