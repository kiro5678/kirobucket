{
    "version": "1.8.5.5748",
    "description": "Android emulator for Windows (NX main engine)",
    "homepage": "https://www.mumuplayer.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://a11.gdl.easebar.com/MuMu-setup-nxmain-V1.8.5.5748-overseas-1013104356.exe",
            "hash": "dd5be7411c9a3ccf78ddaaaea89b295260ceb527713ae66b82d2a82f730919c9"
        }
    },
    "pre_install": [
        "if (!(is_admin)) { throw \"$app requires admin rights to $cmd\" }",
        "$installerPath = Join-Path $dir $fname",
        "$versionParts = $version -split \"\\.\"",
        "if ($versionParts.Count -lt 3) { throw \"Cannot derive MuMuPlayer product version from NXMAIN version $version.\" }",
        "$productVersion = \"6.$($versionParts[1]).$($versionParts[2]).0\"",
        "$txnId = [guid]::NewGuid().ToString()",
        "$commonArguments = @(\"/from_orchestrator=1\", \"/txn_id=$txnId\", \"/silent=1\", \"/product_version=$productVersion\", \"/auto_start=false\", \"/fchannel=gw-overseas12\", \"/auto_run=false\", \"/D=`\"$dir`\"\")",
        "$prepareArguments = @(\"/action=install_prepare\") + $commonArguments",
        "$prepare = Start-Process -FilePath $installerPath -ArgumentList $prepareArguments -Wait -PassThru",
        "if ($prepare.ExitCode -ne 0) { throw \"MuMuPlayer install_prepare failed with exit code $($prepare.ExitCode).\" }",
        "Start-Sleep -Seconds 12",
        "$commitArguments = @(\"/action=commit\") + $commonArguments",
        "$commit = Start-Process -FilePath $installerPath -ArgumentList $commitArguments -Wait -PassThru",
        "if ($commit.ExitCode -ne 0) { throw \"MuMuPlayer commit failed with exit code $($commit.ExitCode).\" }",
        "$mainExe = Join-Path $dir \"nx_main\\MuMuNxMain.exe\"",
        "if (-not (Test-Path $mainExe)) { throw \"MuMuPlayer setup returned successfully but did not create the expected executable: $mainExe\" }"
    ],
    "post_install": "Remove-Item (Join-Path $dir $fname) -Force -ErrorAction SilentlyContinue",
    "shortcuts": [
        [
            "nx_main\\MuMuNxMain.exe",
            "MuMuPlayer"
        ]
    ],
    "persist": [
        "configs",
        "vms"
    ],
    "post_uninstall": [
        "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\MuMuPlayer\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$env:USERPROFILE\\Desktop\\MuMuPlayer.lnk\" -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "script": [
            "$releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/LOVECHEN/mumu-release/releases?per_page=100' -Headers @{ 'Accept' = 'application/vnd.github+json'; 'User-Agent' = 'Scoop-KiroBucket' }",
            "$release = $releases | Where-Object { $_.tag_name -like 'win-global-offline-*' } | Select-Object -First 1",
            "if (-not $release) { throw 'No MuMuPlayer international global release was found.' }",
            "$asset = $release.assets | Where-Object { $_.name -match '^MuMu-setup-nxmain-V[\\d.]+-overseas-[\\d]+\\.exe$' } | Select-Object -First 1",
            "if (-not $asset) { throw 'No NX main installer asset was found in the latest international global release.' }",
            "if ($asset) { $asset.name }"
        ],
        "regex": "nxmain-V(?<version>[\\d.]+)-overseas-(?<build>[\\d]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://a11.gdl.easebar.com/MuMu-setup-nxmain-V$matchVersion-overseas-$matchBuild.exe"
            }
        }
    }
}
