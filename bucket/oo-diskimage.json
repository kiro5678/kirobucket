{
    "version": "23.2.26060",
    "description": "Windows disk imaging and backup utility for creating and restoring complete system and disk images.",
    "homepage": "https://www.oo-software.com/en/diskimage-backup-your-data",
    "license": "Shareware",
    "url": "https://package.oo-software.com/winget/diskimage/23.2.26060/oodiskimage_23.2.26060_premium_eng_x64.msi#/setup.msi_",
    "hash": "a137231f9dbc5f86b0936d3f34bc7815b5795d2029ebe39c61ff85752dda0672",
    "installer": {
        "script": [
            "$msi = Join-Path $dir 'setup.msi_'",
            "if (!(Test-Path -LiteralPath $msi -PathType Leaf)) { throw 'O&O DiskImage Premium MSI was not found: ' + $msi }",
            "$log = Join-Path $dir 'oo-diskimage-install.log'",
            "$process = Start-Process -FilePath 'msiexec.exe' -ArgumentList @('/i', \"`\"$msi`\"\", '/qn', 'REBOOT=ReallySuppress', '/norestart', '/L*V', \"`\"$log`\"\") -Wait -PassThru -Verb RunAs -ErrorAction Stop",
            "if ($process.ExitCode -notin @(0, 3010)) { throw \"O&O DiskImage Premium installation failed with exit code $($process.ExitCode). Log: $log\" }"
        ]
    },
    "uninstaller": {
        "script": [
            "$log = Join-Path $dir 'oo-diskimage-uninstall.log'",
            "$productCode = '{8E21DB8B-6FED-40C8-A785-C9E9D5841EE0}'",
            "$process = Start-Process -FilePath 'msiexec.exe' -ArgumentList @('/x', $productCode, '/qn', 'REBOOT=ReallySuppress', '/norestart', '/L*V', \"`\"$log`\"\") -Wait -PassThru -Verb RunAs -ErrorAction Stop",
            "if ($process.ExitCode -notin @(0, 3010)) { throw \"O&O DiskImage Premium uninstallation failed with exit code $($process.ExitCode). Log: $log\" }"
        ]
    },
    "checkver": {
        "url": "https://www.oo-software.com/en/download/current/oodiskimage",
        "regex": "Build\\s+(?<version>\\d+\\.\\d+\\.\\d+)"
    },
    "autoupdate": {
        "url": "https://package.oo-software.com/winget/diskimage/23.2.26060/oodiskimage_23.2.26060_premium_eng_x64.msi#/setup.msi_"
    }
}
