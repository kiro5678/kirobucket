    "installer": {
        "script": "Invoke-ExternalCommand \"$dir\\$fname\" -ArgumentList @('/S', \"/D=$dir\") -RunAs | Out-Null"
    },
    "uninstaller": {
        "script": "$uninstaller = Get-ChildItem -LiteralPath $dir -Filter 'uninstall.exe' -File -ErrorAction SilentlyContinue | Select-Object -First 1; if ($uninstaller) { Invoke-ExternalCommand $uninstaller.FullName -ArgumentList '/S' -RunAs | Out-Null }"
    },
    "bin": "GiantappWallpaper.exe",
    "shortcuts": [
        [
            "GiantappWallpaper.exe",
            "GiantappWallpaper"
        ]
    ],
    "checkver": {
        "url": "https://github.com/GiantappMan/livewallpaper/releases",
        "regex": "tag/v([0-9]+\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+)"
    },
    "autoupdate": {
        "url": "https://github.com/GiantappMan/livewallpaper/releases/download/v$version/GiantappWallpaper_$version_x64-setup.exe"
    }
}
