{
    "version": "26.10",
    "description": "Combines a text editor and audio player to support keyboard-driven transcription of recordings.",
    "homepage": "https://efsoftware.com/ts/e.htm",
    "license": "Shareware",
    "architecture": {
        "64bit": {
            "url": "https://efsoftware.com/_p4/ts",
            "extract_dir": "ef_talk_scriber_64",
            "shortcuts": [
                [
                    "EFTS.EXE",
                    "EF Talk Scriber"
                ]
            ]
        }
    },
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://efsoftware.com/dw/e.htm' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$needle = 'href=\"/ts/e.htm\"'",
            "$start = $html.IndexOf($needle, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($start -lt 0) { throw 'Could not locate EF Talk Scriber in the official EFSoftware download page.' }",
            "$rowEnd = $html.IndexOf('</tr>', $start, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($rowEnd -lt 0) { throw 'Could not isolate the EF Talk Scriber version row.' }",
            "$row = $html.Substring($start, $rowEnd - $start)",
            "$match = [regex]::Match($row, 'align=right>\\s*(?<version>\\d+\\.\\d+)')",
            "if (-not $match.Success) { throw 'Could not parse the EF Talk Scriber version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://efsoftware.com/_p4/ts",
                "extract_dir": "ef_talk_scriber_64"
            }
        }
    }
}
