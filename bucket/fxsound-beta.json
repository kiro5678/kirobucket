{
    "version": "1.2.16.0",
    "description": "Audio enhancer and sound equalizer for Windows.",
    "homepage": "https://github.com/fxsound2/fxsound-app",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/fxsound2/fxsound-app/releases/download/beta/fxsound_setup.exe",
            "hash": "3e4c6aead03e1dd9f093de4ff9842b8d7ed9487f8b033a87c3ab83e5f65ca710",
            "uninstaller": {
                "file": "fxsound_setup.exe",
                "args": [
                    "/exenoui",
                    "/x",
                    "//",
                    "/qn",
                    "/norestart"
                ]
            }
        },
        "arm64": {
            "url": "https://github.com/fxsound2/fxsound-app/releases/download/beta/fxsound_setup.arm64.exe",
            "hash": "a60e8e73e98e1ddcd4d90deeb53297258d22708efa155fa3479182b648b83a35",
            "uninstaller": {
                "file": "fxsound_setup.arm64.exe",
                "args": [
                    "/exenoui",
                    "/x",
                    "//",
                    "/qn",
                    "/norestart"
                ]
            }
        }
    },
    "installer": {
        "args": [
            "/exenoui",
            "/qn",
            "/norestart",
            "APPDIR=$dir"
        ],
        "keep": true
    },
    "bin": "FxSound.exe",
    "shortcuts": [
        [
            "FxSound.exe",
            "FxSound Beta"
        ]
    ],
    "checkver": {
        "url": "https://github.com/fxsound2/fxsound-app/releases",
        "regex": "Version ([\\d.]+) \\(Beta\\)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/fxsound2/fxsound-app/releases/download/beta/fxsound_setup.exe"
            },
            "arm64": {
                "url": "https://github.com/fxsound2/fxsound-app/releases/download/beta/fxsound_setup.arm64.exe"
            }
        }
    },
    "pre_uninstall": [
        "Get-Process -Name 'FxSound' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "notes": [
        "Uses the official FxSound installer because FxSound requires its virtual audio driver.",
        "The installer places the application in the Scoop app directory via APPDIR and installs the FxSound virtual audio driver system-wide."
    ]
}
