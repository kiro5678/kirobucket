{
    "version": "26.10",
    "description": "Finds duplicate files by name, size, or content, including files inside supported archives.",
    "homepage": "https://efsoftware.com/dm/e.htm",
    "license": "Shareware",
    "architecture": {
        "64bit": {
            "url": "https://efsoftware.com/_p4/dm",
            "extract_dir": "ef_duplicate_files_manager_64",
            "shortcuts": [
                [
                    "EFDFM.EXE",
                    "EF Duplicate Files Manager"
                ]
            ]
        }
    },
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://efsoftware.com/dw/e.htm' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$needle = 'href=\"/dm/e.htm\"'",
            "$start = $html.IndexOf($needle, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($start -lt 0) { throw 'Could not locate EF Duplicate Files Manager in the official EFSoftware download page.' }",
            "$rowEnd = $html.IndexOf('</tr>', $start, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($rowEnd -lt 0) { throw 'Could not isolate the EF Duplicate Files Manager version row.' }",
            "$row = $html.Substring($start, $rowEnd - $start)",
            "$match = [regex]::Match($row, 'align=right>\\s*(?<version>\\d+\\.\\d+)')",
            "if (-not $match.Success) { throw 'Could not parse the EF Duplicate Files Manager version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://efsoftware.com/_p4/dm",
                "extract_dir": "ef_duplicate_files_manager_64"
            }
        }
    }
}
