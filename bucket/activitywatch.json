{
    "version": "0.14.0b8",
    "description": "Open-source automated time tracker.",
    "homepage": "https://activitywatch.net/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ActivityWatch/activitywatch/releases/download/v0.14.0b8/activitywatch-v0.14.0b8-windows-x86_64.zip",
            "hash": "eefcb1e116b08761529cb0db25bc8e42dc1341cf24ed3accc19d9c5bf76a52a6"
        }
    },
    "extract_dir": "activitywatch",
    "bin": "aw-qt.exe",
    "shortcuts": [
        [
            "aw-qt.exe",
            "ActivityWatch"
        ]
    ],
    "checkver": {
        "script": [
            "$auth = Get-GitHubToken",
            "$headers = @{}",
            "if($auth) { $headers['Authorization'] = \"Bearer $auth\" }",
            "$url = 'https://api.github.com/repos/ActivityWatch/activitywatch/releases?per_page=100'",
            "$releases = (Invoke-WebRequest -Headers $headers $url).Content | ConvertFrom-Json",
            "$latest = ''",
            "foreach($release in $releases) {",
            "    if($release.tag_name -match '^v([0-9]+\\.[0-9]+\\.[0-9]+(?:b[0-9]+)?)$') {",
            "        $candidate = $matches[1]",
            "        if(!$latest -or (Compare-Version -ReferenceVersion $candidate -DifferenceVersion $latest) -gt 0) {",
            "            $latest = $candidate",
            "        }",
            "    }",
            "}",
            "if(!$latest) { error 'Could not find an ActivityWatch stable or beta release.'; continue }",
            "Write-Output $latest"
        ],
        "regex": "([0-9]+\\.[0-9]+\\.[0-9]+(?:b[0-9]+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ActivityWatch/activitywatch/releases/download/v$version/activitywatch-v$version-windows-x86_64.zip"
            }
        }
    }
}
