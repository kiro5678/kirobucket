{
    "version": "7.1.2-32",
    "description": "Create, edit, compose, and convert 200+ bitmap image formats.",
    "homepage": "https://imagemagick.org/",
    "license": "ImageMagick",
    "notes": [
        "ImageMagick requires Ghostscript to handle PDF files properly.",
        "You can install it by: scoop install ghostscript",
        "",
        "'convert.exe' is deprecated in v7 (it also conflicts with the builtin Windows 'convert' utility).",
        "Use 'magick convert ...' instead."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ImageMagick/ImageMagick/releases/download/7.1.2-32/ImageMagick-7.1.2-32-portable-Q16-x64.7z",
            "hash": "2540f87550bd24488d71248427b8ab6754573a0506ea0cbe943579fdbddab299"
        },
        "arm64": {
            "url": "https://github.com/ImageMagick/ImageMagick/releases/download/7.1.2-32/ImageMagick-7.1.2-32-portable-Q16-arm64.7z",
            "hash": "f9990a3b852336639802bae29de55997272e9773459bd6161db8ebcf7e006be7"
        }
    },
    "bin": "magick.exe",
    "env_add_path": ".",
    "env_set": {
        "MAGICK_HOME": "$dir",
        "MAGICK_CONFIGURE_PATH": "$dir",
        "MAGICK_CODER_MODULE_PATH": "$dir\\modules\\coders"
    },
    "checkver": {
        "github": "https://api.github.com/repos/ImageMagick/ImageMagick/releases/latest",
        "jsonpath": "$.tag_name"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ImageMagick/ImageMagick/releases/download/$version/ImageMagick-$version-portable-Q16-x64.7z"
            },
            "arm64": {
                "url": "https://github.com/ImageMagick/ImageMagick/releases/download/$version/ImageMagick-$version-portable-Q16-arm64.7z"
            }
        },
        "hash": {
            "mode": "json",
            "url": "https://api.github.com/repos/ImageMagick/ImageMagick/releases/tags/$version",
            "jsonpath": "$.assets[?(@.name == '$basename')].digest"
        }
    }
}
