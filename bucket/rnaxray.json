{
    "version": "0.1.7",
    "description": "Native desktop workbench for chimeric RNA read analysis and structure prediction.",
    "homepage": "https://github.com/Vicky-0256/RNAxRAY",
    "license": "MIT",
    "url": "https://github.com/Vicky-0256/RNAxRAY/releases/download/v0.1.7/RNAxRay-Desktop-Windows-x64-Setup.exe#/setup.exe",
    "hash": "66700f30b92aa0f455b8ff0a49bee7ecf68752aa389f110361732b0b2f177cd7",
    "installer": {
        "script": [
            "$setupPath = Join-Path $dir 'setup.exe'",
            "$process = Start-Process -FilePath $setupPath -ArgumentList @('/S', \"/D=$dir\") -Wait -PassThru",
            "if ($process.ExitCode -ne 0) { throw \"RNAxRay setup exited with code $($process.ExitCode).\" }",
            "Remove-Item -LiteralPath $setupPath -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$uninstallerPath = Join-Path $dir 'Uninstall.exe'",
            "if (Test-Path -LiteralPath $uninstallerPath -PathType Leaf) {",
            "    $process = Start-Process -FilePath $uninstallerPath -ArgumentList @('/S', \"_?=$dir\") -Wait -PassThru",
            "    if ($process.ExitCode -ne 0) { throw \"RNAxRay uninstaller exited with code $($process.ExitCode).\" }",
            "}"
        ]
    },
    "shortcuts": [
        [
            "RNAxRay Desktop.exe",
            "RNAxRay Desktop"
        ]
    ],
    "notes": "The Windows installer is unsigned and may trigger SmartScreen. The release bundles its CPython and scientific runtime.",
    "checkver": {
        "url": "https://api.github.com/repos/Vicky-0256/RNAxRAY/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/Vicky-0256/RNAxRAY/releases/download/v$version/RNAxRay-Desktop-Windows-x64-Setup.exe#/setup.exe",
        "hash": {
            "mode": "json",
            "url": "https://api.github.com/repos/Vicky-0256/RNAxRAY/releases/tags/v$version",
            "jp": "$.assets[?(@.name == 'RNAxRay-Desktop-Windows-x64-Setup.exe')].digest"
        }
    }
}
