{
    "version": "2.0.1",
    "description": "Download Windows Spotlight images and optionally set them as desktop wallpaper or lock screen.",
    "homepage": "https://github.com/ORelio/Spotlight-Downloader",
    "license": "CDDL-1.0",
    "url": "https://github.com/ORelio/Spotlight-Downloader/releases/download/v2.0.1/SpotlightDL-v2.0.1.zip",
    "hash": "912457d2a8da5e269c397885f9bdd57910bf0806941b037362284b8afcf55de2",
    "bin": "SpotlightDownloader.exe",
    "checkver": {
        "script": [
            "$headers = @{ 'Accept' = 'application/vnd.github+json'; 'User-Agent' = 'Scoop-KiroBucket' }",
            "if (-not [string]::IsNullOrWhiteSpace($env:GITHUB_TOKEN)) { $headers['Authorization'] = \"Bearer $env:GITHUB_TOKEN\" }",
            "$releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/ORelio/Spotlight-Downloader/releases?per_page=100' -Headers $headers",
            "$release = $releases | Where-Object { $tag = [string]$_.tag_name; $assetName = 'SpotlightDL-' + $tag.Substring(1) + '.zip'; $tag -match '^v2\\.\\d+\\.\\d+$' -and (($_.assets | ForEach-Object { $_.name }) -contains $assetName) } | Select-Object -First 1",
            "if (-not $release) { throw 'No stable Spotlight Downloader v2 release with its matching ZIP was found.' }",
            "Write-Output $release.tag_name"
        ],
        "regex": "^v(?<version>2\\.[\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/ORelio/Spotlight-Downloader/releases/download/v$version/SpotlightDL-v$version.zip",
        "hash": {
            "url": "https://api.github.com/repos/ORelio/Spotlight-Downloader/releases/tags/v$version",
            "regex": "\"name\"\\s*:\\s*\"SpotlightDL-v$version\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
        }
    },
    "notes": [
        "Uses the official portable ZIP for the Windows .NET 9 release, not the separate Lockscreen Setup installer.",
        "SpotlightDownloader.exe is exposed as a Scoop command. The bundled batch scripts are not added as shortcuts because they create their archive/cache beside the script inside Scoop's versioned app directory; use the command-line --outdir option for data you want to keep across updates."
    ]
}
