{
    "##": "Portable extraction from the official Inno Setup package. The vendor setup is not executed and no Windows service or Run-key entry is created.",
    "version": "0.1.2",
    "description": "Windows disk-space monitor that records free-space changes, storage growth, and the processes writing to disk.",
    "homepage": "https://github.com/AnwarRezk/disk-monitor",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnwarRezk/disk-monitor/releases/download/v0.1.2/DiskDrift-Setup-0.1.2.exe",
            "hash": "6a9b655af7d6b7341c9446cda9a214a6ecda47236e645aad2de8f14dd466177c"
        }
    },
    "innosetup": true,
    "pre_install": [
        "$persistDataDir = Join-Path $persist_dir 'data'",
        "if (Test-Path -LiteralPath $persistDataDir -PathType Container) {",
        "    $dataDir = $persistDataDir",
        "} else {",
        "    $dataDir = Join-Path $dir 'data'",
        "    New-Item -ItemType Directory -Path $dataDir -Force | Out-Null",
        "}",
        "$acl = [System.Security.AccessControl.DirectorySecurity]::new()",
        "$acl.SetAccessRuleProtection($true, $false)",
        "$inherit = [System.Security.AccessControl.InheritanceFlags]::ContainerInherit -bor [System.Security.AccessControl.InheritanceFlags]::ObjectInherit",
        "$acl.AddAccessRule([System.Security.AccessControl.FileSystemAccessRule]::new([System.Security.Principal.SecurityIdentifier]::new('S-1-5-18'), [System.Security.AccessControl.FileSystemRights]::FullControl, $inherit, [System.Security.AccessControl.PropagationFlags]::None, [System.Security.AccessControl.AccessControlType]::Allow))",
        "$acl.AddAccessRule([System.Security.AccessControl.FileSystemAccessRule]::new([System.Security.Principal.SecurityIdentifier]::new('S-1-5-32-544'), [System.Security.AccessControl.FileSystemRights]::FullControl, $inherit, [System.Security.AccessControl.PropagationFlags]::None, [System.Security.AccessControl.AccessControlType]::Allow))",
        "$usersRights = [System.Security.AccessControl.FileSystemRights]::ReadAndExecute -bor [System.Security.AccessControl.FileSystemRights]::Synchronize",
        "$acl.AddAccessRule([System.Security.AccessControl.FileSystemAccessRule]::new([System.Security.Principal.SecurityIdentifier]::new('S-1-5-32-545'), $usersRights, $inherit, [System.Security.AccessControl.PropagationFlags]::None, [System.Security.AccessControl.AccessControlType]::Allow))",
        "Set-Acl -LiteralPath $dataDir -AclObject $acl"
    ],
    "post_install": [
        "$configPath = Join-Path $dir 'Collector\\appsettings.json'",
        "if (-not (Test-Path -LiteralPath $configPath -PathType Leaf)) { throw \"DiskDrift configuration file was not found: $configPath\" }",
        "$config = Get-Content -LiteralPath $configPath -Raw | ConvertFrom-Json",
        "$config.DiskDrift.DataDirectory = Join-Path $persist_dir 'data'",
        "$configJson = $config | ConvertTo-Json -Depth 100",
        "[System.IO.File]::WriteAllText($configPath, $configJson + [Environment]::NewLine, [System.Text.UTF8Encoding]::new($false))"
    ],
    "persist": [
        "data"
    ],
    "bin": [
        [
            "Collector\\DiskDrift.Collector.exe",
            "diskdrift-collector"
        ],
        [
            "Tray\\DiskDrift.Tray.exe",
            "diskdrift"
        ]
    ],
    "shortcuts": [
        [
            "Tray\\DiskDrift.Tray.exe",
            "DiskDrift"
        ]
    ],
    "checkver": {
        "github": "https://github.com/AnwarRezk/disk-monitor"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnwarRezk/disk-monitor/releases/download/v$version/DiskDrift-Setup-$version.exe",
                "hash": {
                    "mode": "github"
                }
            }
        }
    },
    "notes": [
        "Portable install: Scoop extracts the application files from the Inno Setup package; the vendor setup and its service-registration steps are not run.",
        "Start the Collector from an elevated PowerShell session with: diskdrift-collector. Keep that console window open while monitoring.",
        "Start the tray and dashboard with: diskdrift, or use the Start Menu shortcut.",
        "The Collector must run elevated because the upstream application requires Administrator rights for its system-wide monitoring. It runs as a console process, not as a Windows service, and does not start automatically with Windows.",
        "The database and logs are stored in Scoop's persistent data directory and are retained when the application is uninstalled."
    ]
}
