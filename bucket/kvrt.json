{
    "version": "20.0.14.0.202608100708",
    "description": "Kaspersky Virus Removal Tool",
    "homepage": "https://me.kaspersky.com/downloads/free-virus-removal-tool",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.kaspersky.com/end-user-license-agreement"
    },
    "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe",
    "bin": "KVRT.exe",
    "shortcuts": [
        [
            "KVRT.exe",
            "Kaspersky Virus Removal Tool",
            "-accepteula"
        ]
    ],
    "checkver": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$xmlUrl = 'https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/kvrt.xml'",
            "$tempDir = [System.IO.Path]::GetTempPath()",
            "$id = [guid]::NewGuid().ToString('N')",
            "$cookieJar = Join-Path $tempDir ('kvrt-' + $id + '.cookies')",
            "$xmlPath = Join-Path $tempDir ('kvrt-' + $id + '.xml')",
            "$userAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36'",
            "function Get-KvrtMetadata {",
            "    param([string]$SourceUrl, [int]$TimeoutSeconds = 60)",
            "    $null = & curl.exe --silent --show-error --location --max-time $TimeoutSeconds --user-agent $userAgent --cookie $cookieJar --cookie-jar $cookieJar --output $xmlPath $SourceUrl 2>$null",
            "    if ($LASTEXITCODE -ne 0 -or -not (Test-Path -LiteralPath $xmlPath)) { return $null }",
            "    $body = [System.IO.File]::ReadAllText($xmlPath)",
            "    $versionMatch = [regex]::Match($body, '(?i)version\\s*=\\s*\\"(?<version>\\d+(?:\\.\\d+){3})\\"')",
            "    $stampMatch = [regex]::Match($body, '(?i)databases_timestamp\\s*=\\s*\\"(?<stamp>\\d{12})\\"')",
            "    if (-not $versionMatch.Success -or -not $stampMatch.Success) { return $null }",
            "    return [pscustomobject]@{ Version = $versionMatch.Groups['version'].Value; Stamp = $stampMatch.Groups['stamp'].Value }",
            "}",
            "try {",
            "    $metadata = Get-KvrtMetadata -SourceUrl $xmlUrl -TimeoutSeconds 45",
            "    if (-not $metadata) {",
            "        for ($attempt = 1; $attempt -le 3 -and -not $metadata; $attempt++) {",
            "            $archiveUrl = 'https://web.archive.org/save/' + $xmlUrl",
            "            $metadata = Get-KvrtMetadata -SourceUrl $archiveUrl -TimeoutSeconds 120",
            "            if (-not $metadata -and $attempt -lt 3) { Start-Sleep -Seconds 5 }",
            "        }",
            "    }",
            "    if (-not $metadata) {",
            "        $snapshotUrl = 'https://web.archive.org/web/2id_/' + $xmlUrl",
            "        $metadata = Get-KvrtMetadata -SourceUrl $snapshotUrl -TimeoutSeconds 90",
            "    }",
            "    if (-not $metadata) { throw 'Could not retrieve version and database timestamp from Kaspersky KVRT metadata or the Wayback Machine.' }",
            "    '{0}.{1}' -f $metadata.Version, $metadata.Stamp",
            "} finally {",
            "    Remove-Item -LiteralPath $cookieJar, $xmlPath -Force -ErrorAction SilentlyContinue",
            "}"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+){3}\\.\\d{12})$"
    },
    "autoupdate": {
        "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe"
    },
    "pre_install": [
        "$exe = Join-Path $dir 'KVRT.exe'",
        "$signature = Get-AuthenticodeSignature -FilePath $exe",
        "if ($signature.Status -ne 'Valid') { throw \\"KVRT.exe has no valid Authenticode signature (status: $($signature.Status)). Refusing to install.\\" }",
        "if ($null -eq $signature.SignerCertificate -or $signature.SignerCertificate.Subject -notmatch '(?i)Kaspersky') { throw 'KVRT.exe is not signed by Kaspersky. Refusing to install.' }"
    ]
}
