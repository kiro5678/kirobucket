{
    "version": "20.0.8.0",
    "description": "Kaspersky Virus Removal Tool",
    "homepage": "https://www.kaspersky.com/downloads/free-virus-removal-tool",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.kaspersky.com/end-user-license-agreement"
    },
    "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe",
    "hash": "ae2f719895c3404857de40bba42075c597c7bddecef03675ed62f856fa5dec20",
    "bin": "KVRT.exe",
    "shortcuts": [
        [
            "KVRT.exe",
            "KVRT"
        ]
    ],
    "checkver": {
        "script": [
            "$apiUrl = 'https://api-router.kaspersky-labs.com/downloads/search/v4/b2c?productcodes=3875874&businesspurposes=Update&sites=https%3A%2F%2Fwww.kaspersky.com'",
            "$headers = @{ 'User-Agent' = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/130.0 Safari/537.36'; 'Referer' = 'https://www.kaspersky.com/downloads/free-virus-removal-tool'; 'Accept' = 'application/json, text/plain, */*' }",
            "$json = $null",
            "for ($attempt = 1; $attempt -le 3 -and $null -eq $json; $attempt++) {",
            "  try {",
            "    $response = Invoke-WebRequest -Uri $apiUrl -Headers $headers -TimeoutSec 30 -UseBasicParsing -ErrorAction Stop",
            "    $json = [string]$response.Content | ConvertFrom-Json -ErrorAction Stop",
            "  } catch {",
            "    if ($attempt -lt 3) { Start-Sleep -Seconds 2 }",
            "  }",
            "}",
            "$version = $null",
            "if ($null -ne $json) {",
            "  $obj = $json[0].response.Windows.kvrt.Build.'https://www.kaspersky.com'.Kaspersky.'20'.'en-INT,ru-INT'",
            "  if ($null -ne $obj -and -not [string]::IsNullOrWhiteSpace([string]$obj.VersionNumberMajor)) {",
            "    $version = \"{0}.{1}.{2}.{3}\" -f $obj.VersionNumberMajor,$obj.VersionNumberMinor,$obj.VersionNumberBuild,$obj.VersionNumberRevision",
            "  }",
            "}",
            "if ([string]::IsNullOrWhiteSpace($version)) {",
            "  $downloadUrl = 'https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe'",
            "  $tempFile = Join-Path ([System.IO.Path]::GetTempPath()) ('KVRT-checkver-' + [guid]::NewGuid().ToString('N') + '.exe')",
            "  try {",
            "    Invoke-WebRequest -Uri $downloadUrl -Headers @{ 'User-Agent' = $headers['User-Agent'] } -OutFile $tempFile -TimeoutSec 180 -UseBasicParsing -ErrorAction Stop",
            "    $fileInfo = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($tempFile)",
            "    foreach ($candidate in @($fileInfo.ProductVersion, $fileInfo.FileVersion)) {",
            "      if ($candidate -match '^\\d+(?:\\.\\d+){3}$') { $version = $candidate; break }",
            "    }",
            "    if ([string]::IsNullOrWhiteSpace($version)) { throw \"Official KVRT executable did not expose a four-part ProductVersion/FileVersion (ProductVersion='$($fileInfo.ProductVersion)', FileVersion='$($fileInfo.FileVersion)').\" }",
            "  } finally {",
            "    Remove-Item -LiteralPath $tempFile -Force -ErrorAction SilentlyContinue",
            "  }",
            "}",
            "$version"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+){3})$"
    },
    "autoupdate": {
        "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe"
    }
}
