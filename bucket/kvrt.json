{
    "version": "20.0.14.0-202610280228",
    "description": "Kaspersky Virus Removal Tool",
    "homepage": "https://www.kaspersky.com/downloads/free-virus-removal-tool",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.kaspersky.com/end-user-license-agreement"
    },
    "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe",
    "bin": "KVRT.exe",
    "shortcuts": [
        [
            "KVRT.exe",
            "KVRT"
        ]
    ],
    "checkver": {
        "script": [
            "$xmlUrl = 'https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/kvrt.xml'",
            "$browserUa = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36'",
            "$tempDir = [System.IO.Path]::GetTempPath()",
            "$cookieJar = Join-Path $tempDir ('KVRT-checkver-' + [guid]::NewGuid().ToString('N') + '.cookies.txt')",
            "function Get-KvrtVersion {",
            "  param([string]$Url, [int]$TimeoutSeconds = 60)",
            "  $tempFile = Join-Path $tempDir ('KVRT-metadata-' + [guid]::NewGuid().ToString('N') + '.xml')",
            "  try {",
            "    $status = & curl.exe -sL --silent --show-error --max-time $TimeoutSeconds -A $browserUa -c $cookieJar -b $cookieJar --write-out '%{http_code}' --output $tempFile $Url 2>$null",
            "    $curlExitCode = $LASTEXITCODE",
            "    $statusCode = ($status -join '').Trim()",
            "    if ($curlExitCode -ne 0 -or $statusCode -notmatch '^2\\d\\d$' -or -not (Test-Path -LiteralPath $tempFile)) { return $null }",
            "    $body = [System.IO.File]::ReadAllText($tempFile)",
            "    $versionMatch = [regex]::Match($body, 'version\\s*=\\s*\"([^\"]+)\"')",
            "    $stampMatch = [regex]::Match($body, 'databases_timestamp\\s*=\\s*\"([^\"]+)\"')",
            "    if (-not $versionMatch.Success -or -not $stampMatch.Success) { return $null }",
            "    $productVersion = $versionMatch.Groups[1].Value",
            "    $timestamp = $stampMatch.Groups[1].Value",
            "    if ($productVersion -notmatch '^\\d+(?:\\.\\d+){3}$' -or $timestamp -notmatch '^\\d{12}$') { return $null }",
            "    return \"$productVersion-$timestamp\"",
            "  } finally {",
            "    Remove-Item -LiteralPath $tempFile -Force -ErrorAction SilentlyContinue",
            "  }",
            "}",
            "$version = $null",
            "try {",
            "  $version = Get-KvrtVersion -Url $xmlUrl -TimeoutSeconds 60",
            "  if ([string]::IsNullOrWhiteSpace($version)) {",
            "    for ($attempt = 1; $attempt -le 3 -and [string]::IsNullOrWhiteSpace($version); $attempt++) {",
            "      $version = Get-KvrtVersion -Url ('https://web.archive.org/save/' + $xmlUrl) -TimeoutSeconds 180",
            "      if ([string]::IsNullOrWhiteSpace($version) -and $attempt -lt 3) { Start-Sleep -Seconds 5 }",
            "    }",
            "  }",
            "  if ([string]::IsNullOrWhiteSpace($version)) {",
            "    $version = Get-KvrtVersion -Url ('https://web.archive.org/web/2id_/' + $xmlUrl) -TimeoutSeconds 120",
            "  }",
            "} finally {",
            "  Remove-Item -LiteralPath $cookieJar -Force -ErrorAction SilentlyContinue",
            "}",
            "if ([string]::IsNullOrWhiteSpace($version)) { throw 'Could not read KVRT version and databases_timestamp from the official kvrt.xml or Wayback Machine fallback.' }",
            "$version"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+){3}-\\d{12})$"
    },
    "autoupdate": {
        "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe"
    }
}
