{
    "version": "20.0.14.0.202610280228",
    "description": "Kaspersky Virus Removal Tool",
    "homepage": "https://me.kaspersky.com/downloads/free-virus-removal-tool",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.kaspersky.com/end-user-license-agreement"
    },
    "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe",
    "bin": "KVRT.exe",
    "shortcuts": [
        [
            "KVRT.exe",
            "Kaspersky Virus Removal Tool",
            "-accepteula"
        ]
    ],
    "checkver": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$xmlUrl = 'https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/kvrt.xml'",
            "$tempDir = [System.IO.Path]::GetTempPath()",
            "$id = [guid]::NewGuid().ToString('N')",
            "$cookieJar = Join-Path $tempDir ('kvrt-' + $id + '.cookies')",
            "$xmlPath = Join-Path $tempDir ('kvrt-' + $id + '.xml')",
            "$userAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36'",
            "$kvrtFetchErrors = [System.Collections.Generic.List[string]]::new()",
            "function Get-KvrtMetadata {",
            "    param([string]$SourceUrl, [int]$TimeoutSeconds = 60)",
            "    Remove-Item -LiteralPath $xmlPath -Force -ErrorAction SilentlyContinue",
            "    $status = & curl.exe --fail --silent --location --max-time $TimeoutSeconds --user-agent $userAgent --cookie $cookieJar --cookie-jar $cookieJar --output $xmlPath --write-out '%{http_code}' $SourceUrl 2>$null",
            "    $curlExitCode = $LASTEXITCODE",
            "    if ($curlExitCode -ne 0 -or -not (Test-Path -LiteralPath $xmlPath)) {",
            "        $kvrtFetchErrors.Add(('{0}: HTTP {1}, curl exit {2}' -f $SourceUrl, ([string]$status).Trim(), $curlExitCode))",
            "        return $null",
            "    }",
            "    $body = [System.IO.File]::ReadAllText($xmlPath)",
            "    $versionMatch = [regex]::Match($body, '(?i)version\\s*=\\s*\"(?<version>\\d+(?:\\.\\d+){3})\"')",
            "    $stampMatch = [regex]::Match($body, '(?i)databases_timestamp\\s*=\\s*\"(?<stamp>\\d{12})\"')",
            "    if (-not $versionMatch.Success -or -not $stampMatch.Success) {",
            "        if ($SourceUrl -eq $xmlUrl) { throw 'Kaspersky returned kvrt.xml successfully, but the expected version or databases_timestamp fields were absent.' }",
            "        $kvrtFetchErrors.Add(('{0}: HTTP {1}, expected metadata fields were absent' -f $SourceUrl, ([string]$status).Trim()))",
            "        return $null",
            "    }",
            "    return [pscustomobject]@{ Version = $versionMatch.Groups['version'].Value; Stamp = $stampMatch.Groups['stamp'].Value }",
            "}",
            "try {",
            "    $metadata = Get-KvrtMetadata -SourceUrl $xmlUrl -TimeoutSeconds 30",
            "    if (-not $metadata) {",
            "        for ($attempt = 1; $attempt -le 2 -and -not $metadata; $attempt++) {",
            "            $archiveUrl = 'https://web.archive.org/save/' + $xmlUrl",
            "            $metadata = Get-KvrtMetadata -SourceUrl $archiveUrl -TimeoutSeconds 45",
            "            if (-not $metadata -and $attempt -lt 2) { Start-Sleep -Seconds 2 }",
            "        }",
            "    }",
            "    if (-not $metadata) {",
            "        $snapshotUrl = 'https://web.archive.org/web/2id_/' + $xmlUrl",
            "        $metadata = Get-KvrtMetadata -SourceUrl $snapshotUrl -TimeoutSeconds 30",
            "    }",
            "    if (-not $metadata) { throw ('Could not reach Kaspersky KVRT metadata or a usable Wayback snapshot. Attempts: ' + ($kvrtFetchErrors -join ' | ')) }",
            "    '{0}.{1}' -f $metadata.Version, $metadata.Stamp",
            "} finally {",
            "    Remove-Item -LiteralPath $cookieJar, $xmlPath -Force -ErrorAction SilentlyContinue",
            "}"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+){3}\\.\\d{12})$"
    },
    "autoupdate": {
        "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe"
    },
    "pre_install": [
        "$exe = Join-Path $dir 'KVRT.exe'",
        "$signature = Get-AuthenticodeSignature -FilePath $exe",
        "if ($signature.Status -ne 'Valid') { throw \"KVRT.exe has no valid Authenticode signature (status: $($signature.Status)). Refusing to install.\" }",
        "if ($null -eq $signature.SignerCertificate -or $signature.SignerCertificate.Subject -notmatch '(?i)Kaspersky') { throw 'KVRT.exe is not signed by Kaspersky. Refusing to install.' }"
    ],
    "notes": [
        "The manifest version combines Kaspersky's product version with the database timestamp (YYYYMMDDHHMM) from kvrt.xml to detect refreshed builds behind the unversioned latest download URL.",
        "Version detection tries Kaspersky's official metadata first. If the endpoint blocks the CI runner, it tries the Internet Archive save endpoint, then an archived snapshot. The executable download URL remains on Kaspersky's official host.",
        "Installation is refused unless KVRT.exe has a valid Authenticode signature from Kaspersky."
    ]
}
