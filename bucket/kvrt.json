{
    "version": "20.0.14.0",
    "description": "Kaspersky Virus Removal Tool",
    "homepage": "https://www.kaspersky.com/downloads/free-virus-removal-tool",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.kaspersky.com/end-user-license-agreement"
    },
    "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe",
    "bin": "KVRT.exe",
    "shortcuts": [
        [
            "KVRT.exe",
            "KVRT"
        ]
    ],
    "checkver": {
        "script": [
            "$urls = @('https://devbuilds.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.xml', 'https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.xml', 'https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/kvrt.xml', 'http://devbuilds.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.xml', 'http://devbuilds.kaspersky-labs.com/devbuilds/KVRT/latest/full/kvrt.xml')",
            "$headers = @{ 'User-Agent' = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131.0.0.0 Safari/537.36'; 'Accept' = 'application/xml, text/xml, */*'; 'Referer' = 'https://www.kaspersky.com/downloads/free-virus-removal-tool' }",
            "$xml = $null",
            "$errors = @()",
            "foreach ($sourceUrl in $urls) {",
            "    for ($attempt = 1; $attempt -le 2; $attempt++) {",
            "        try {",
            "            $response = Invoke-WebRequest -Uri $sourceUrl -Headers $headers -TimeoutSec 15 -UseBasicParsing -ErrorAction Stop",
            "            $candidate = [string]$response.Content",
            "            if ([string]::IsNullOrWhiteSpace($candidate)) { throw 'The official KVRT XML response was empty.' }",
            "            $xml = $candidate",
            "            break",
            "        } catch {",
            "            $errors += \"$sourceUrl (attempt $attempt): $($_.Exception.Message)\"",
            "            if ($attempt -lt 2) { Start-Sleep -Seconds 2 }",
            "        }",
            "    }",
            "    if (-not [string]::IsNullOrWhiteSpace($xml)) { break }",
            "}",
            "if ([string]::IsNullOrWhiteSpace($xml)) { throw ('Could not retrieve official KVRT version metadata. ' + ($errors -join ' | ')) }",
            "$match = [regex]::Match($xml, '(?i)(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'The official KVRT XML did not contain a four-part version.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+){3})$"
    },
    "autoupdate": {
        "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe"
    },
    "pre_install": [
        "$exe = Join-Path $dir 'KVRT.exe'",
        "$signature = Get-AuthenticodeSignature -FilePath $exe",
        "if ($signature.Status -ne 'Valid') { throw \"KVRT.exe has no valid Authenticode signature (status: $($signature.Status)). Refusing to install.\" }",
        "if ($null -eq $signature.SignerCertificate -or $signature.SignerCertificate.Subject -notmatch '(?i)Kaspersky') { throw 'KVRT.exe is not signed by Kaspersky. Refusing to install.' }"
    ]
}
