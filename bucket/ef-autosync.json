{
    "version": "26.10",
    "description": "Portable utility for synchronizing files and folders between PCs, USB flash drives, external drives, and other storage.",
    "homepage": "https://efsoftware.com/as/e.htm",
    "license": "Shareware",
    "architecture": {
        "64bit": {
            "url": "https://efsoftware.com/_p4/as",
            "extract_dir": "ef_autosync_64",
            "shortcuts": [
                [
                    "EFAS.EXE",
                    "EF AutoSync"
                ]
            ]
        }
    },
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://efsoftware.com/dw/e.htm' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$needle = 'href=\"/as/e.htm\"'",
            "$start = $html.IndexOf($needle, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($start -lt 0) { throw 'Could not locate EF AutoSync in the official EFSoftware download page.' }",
            "$rowEnd = $html.IndexOf('</tr>', $start, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($rowEnd -lt 0) { throw 'Could not isolate the EF AutoSync version row.' }",
            "$row = $html.Substring($start, $rowEnd - $start)",
            "$match = [regex]::Match($row, 'align=right>\\s*(?<version>\\d+\\.\\d+)')",
            "if (-not $match.Success) { throw 'Could not parse the EF AutoSync version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://efsoftware.com/_p4/as",
                "extract_dir": "ef_autosync_64"
            }
        }
    }
}
