    "license": "Proprietary",
    "url": "https://vovsoft.com/files/filename-lister-portable.zip?v=5.4",
    "checkver": {
        "url": "https://vovsoft.com/software/filename-lister/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
