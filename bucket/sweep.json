                "url": "https://github.com/yaffalhakim1/sweep/releases/download/v$version/Sweep-$version-windows-amd64.exe"
            },
            "arm64": {
                "url": "https://github.com/yaffalhakim1/sweep/releases/download/v$version/Sweep-$version-windows-arm64.exe"
            }
