{
    "version": "0.4.0",
    "description": "Windows disk-space analyzer for locating and permanently removing regenerable build artifacts.",
    "homepage": "https://github.com/yaffalhakim1/sweep",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/yaffalhakim1/sweep/releases/download/v0.4.0/Sweep-0.4.0-windows-amd64.exe",
            "hash": "7f2a72f78884fd6418be5e7e27fa4ab83403661d2576c90351f457fe7320d56c"
        },
        "arm64": {
            "url": "https://github.com/yaffalhakim1/sweep/releases/download/v0.4.0/Sweep-0.4.0-windows-arm64.exe",
            "hash": "4a158f346edee376401eb68874a14b5c48748c244e88760514dca8efe1100e28"
        }
    },
    "pre_install": "$binary = Get-ChildItem -LiteralPath $dir -Filter 'Sweep-*-windows-*.exe' -File | Select-Object -First 1; if ($null -eq $binary) { throw 'Sweep executable was not found.' }; Rename-Item -LiteralPath $binary.FullName -NewName 'Sweep.exe'",
    "bin": "Sweep.exe",
    "shortcuts": [
        [
            "Sweep.exe",
            "Sweep"
        ]
    ],
    "checkver": {
        "github": "https://github.com/yaffalhakim1/sweep"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yaffalhakim1/sweep/releases/download/v$version/Sweep-$version-windows-amd64.exe"
            },
            "arm64": {
                "url": "https://github.com/yaffalhakim1/sweep/releases/download/v$version/Sweep-$version-windows-arm64.exe"
            }
        }
    },
    "notes": "Sweep permanently deletes selected build-artifact folders instead of sending them to the Recycle Bin. Review every selection before confirming."
}
