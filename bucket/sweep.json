    "pre_install": "$binary = Get-ChildItem -LiteralPath $dir -Filter 'Sweep-*-windows-*.exe' -File | Select-Object -First 1; if ($null -eq $binary) { throw 'Sweep executable was not found.' }; Rename-Item -LiteralPath $binary.FullName -NewName 'Sweep.exe'",
