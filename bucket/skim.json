{
    "version": "1.0.34",
    "description": "A fast, minimalist, AI-native email client for Windows.",
    "homepage": "https://skim-tech.com",
    "license": "MIT",
    "notes": [
        "Skim's built-in updater is disabled for Scoop-managed installs; use 'scoop update skim'.",
        "Mail, settings, and credentials are stored outside the app folder and remain after uninstall."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/nikserg/skim/releases/download/v1.0.34/Skim_1.0.34_x64-setup.exe#/dl.7z",
            "hash": "fb4015d95eb51275ef49fd56faac85d20430f12de7ff0a569350c831809ddea7"
        }
    },
    "post_install": [
        "Remove-Item (Join-Path $dir '$PLUGINSDIR') -Recurse -Force -ErrorAction Ignore",
        "Remove-Item (Join-Path $dir 'uninstall.exe') -Force -ErrorAction Ignore",
        "New-Item (Join-Path $dir '.managed-updates') -ItemType File -Force | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "Remove-Item 'HKCU:\\Software\\Classes\\AppUserModelId\\com.skim.app' -Recurse -Force -ErrorAction Ignore",
            "Remove-Item 'HKCU:\\Software\\Classes\\skim' -Recurse -Force -ErrorAction Ignore"
        ]
    },
    "bin": "skim.exe",
    "shortcuts": [
        [
            "skim.exe",
            "Skim"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/nikserg/skim/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nikserg/skim/releases/download/v$version/Skim_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
}
