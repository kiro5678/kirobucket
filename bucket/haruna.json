{
    "version": "1944",
    "description": "An open source media player built with Qt/QML and libmpv",
    "homepage": "https://haruna.kde.org/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://cdn.kde.org/ci-builds/multimedia/haruna/master/windows/haruna-master-1944-windows-gcc-x86_64.7z"
        }
    },
    "bin": "bin\\haruna.exe",
    "shortcuts": [
        [
            "bin\\haruna.exe",
            "Haruna"
        ]
    ],
    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/126.0 Safari/537.36' }",
            "$page = Invoke-WebRequest -Uri 'https://cdn.kde.org/ci-builds/multimedia/haruna/master/windows/' -Headers $headers -TimeoutSec 30",
            "$match = [regex]::Match($page.Content, 'haruna-master-(?<version>\\d+)-windows-gcc-x86_64\\.7z')",
            "if (-not $match.Success) { throw 'Could not find Haruna Windows x64 archive in the official KDE index.' }",
            "Write-Output $match.Groups['version'].Value"
        ],
        "regex": "^(?<version>\\d+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.kde.org/ci-builds/multimedia/haruna/master/windows/haruna-master-$version-windows-gcc-x86_64.7z",
                "hash": {
                    "url": "$url.sha256",
                    "regex": "([a-f0-9]{64})"
                }
            }
        }
    }
}
