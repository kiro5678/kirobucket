{
    "version": "1.8.1",
    "description": "An open source media player built with Qt/QML and libmpv",
    "homepage": "https://haruna.kde.org/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://cdn.kde.org/ci-builds/multimedia/haruna/master/windows/haruna-master-1944-windows-gcc-x86_64.7z"
        }
    },
    "bin": "bin\\haruna.exe",
    "shortcuts": [
        [
            "bin\\haruna.exe",
            "Haruna"
        ]
    ],
    "checkver": {
        "script": [
            "$html = & curl.exe --fail --location --silent --show-error --max-time 30 --user-agent 'Mozilla/5.0' 'https://download.kde.org/stable/haruna/'",
            "if ($LASTEXITCODE -ne 0) { throw 'Could not download the official KDE Haruna stable index.' }",
            "$matches = [regex]::Matches(($html -join \"`n\"), 'href=\"(?<version>\\d+(?:\\.\\d+){1,2})/\"')",
            "$versions = @($matches | ForEach-Object { [version]$_.Groups['version'].Value } | Sort-Object -Descending)",
            "if ($versions.Count -eq 0) { throw 'Could not find a stable Haruna version in the official KDE index.' }",
            "Write-Output $versions[0].ToString()"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+){1,2})$"
    },
    "autoupdate": {
        "url": "https://download.kde.org/stable/haruna/$version/haruna-$version-windows-gcc-x86_64.7z"
    },
    "url": "https://download.kde.org/stable/haruna/1.8.1/haruna-1.8.1-windows-gcc-x86_64.7z"
}
