{
    "version": "1944",
    "description": "An open source media player built with Qt/QML and libmpv",
    "homepage": "https://haruna.kde.org/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://cdn.kde.org/ci-builds/multimedia/haruna/master/windows/haruna-master-1944-windows-gcc-x86_64.7z"
        }
    },
    "bin": "bin\\haruna.exe",
    "shortcuts": [
        [
            "bin\\haruna.exe",
            "Haruna"
        ]
    ],
    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'Mozilla/5.0' }",
            "$html = & curl.exe --fail --location --silent --show-error --max-time 30 --user-agent 'Mozilla/5.0' 'https://cdn.kde.org/ci-builds/multimedia/haruna/master/windows/'",
            "if ($LASTEXITCODE -ne 0) { throw 'Could not download the official KDE Haruna index.' }",
            "$matches = [regex]::Matches(($html -join \"`n\"), 'haruna-master-(\\d+)-windows-gcc-x86_64(?:\\.7z|\\.exe)')",
            "if ($matches.Count -eq 0) { throw 'Could not find Haruna Windows x64 artifacts in the official KDE index.' }",
            "$version = ($matches | ForEach-Object { [int]$_.Groups[1].Value } | Measure-Object -Maximum).Maximum",
            "Write-Output $version"
        ],
        "regex": "^(?<version>\\d+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.kde.org/ci-builds/multimedia/haruna/master/windows/haruna-master-$version-windows-gcc-x86_64.7z",
                "hash": {
                    "url": "$url.sha256",
                    "regex": "([a-f0-9]{64})"
                }
            }
        }
    }
}
