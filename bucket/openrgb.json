    "checkver": {
        "url": "https://api.github.com/repos/CalcProgrammer1/OpenRGB/releases/latest",
        "jsonpath": "$.assets[*].name",
        "regex": "OpenRGB_(?<version>[\\d.]+)_Windows_64_(?<commit>[\\da-fA-F]{7})\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CalcProgrammer1/OpenRGB/releases/download/release_$version/OpenRGB_$version_Windows_64_$matchCommit.zip"
            },
            "32bit": {
                "url": "https://github.com/CalcProgrammer1/OpenRGB/releases/download/release_$version/OpenRGB_$version_Windows_32_$matchCommit.zip"
            }
        }
    },
    "pre_install": [
        "$exe = Get-ChildItem -LiteralPath $dir -Filter 'OpenRGB.exe' -File -Recurse | Select-Object -First 1",
        "if ($null -eq $exe) { throw 'OpenRGB.exe was not found in the extracted archive.' }",
        "if ($exe.DirectoryName -ne $dir) { Get-ChildItem -LiteralPath $exe.DirectoryName -Force | ForEach-Object { Move-Item -LiteralPath $_.FullName -Destination $dir -Force } }"
    ]
}
